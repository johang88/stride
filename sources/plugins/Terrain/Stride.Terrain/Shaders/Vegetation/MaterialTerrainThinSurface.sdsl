namespace Stride.Terrain
{
    /// <summary>
    /// Marks the surface as thin (blades, leaves): screen-space effects don't take it for a solid behind its depth.
    /// </summary>
    shader MaterialTerrainThinSurface : IMaterialSurfacePixel
    {
        override void Compute()
        {
            streams.matThinSurface = 1.0;
        }
    };
}

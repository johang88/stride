namespace Stride.Terrain
{
    /// <summary>
    /// Sways plants in the wind: world space offset growing with the height above the model origin, travelling as a wave
    /// along the wind direction, with a little variation per vertex. The previous frame's offset goes to the velocity pass.
    /// </summary>
    shader MaterialTerrainGrassWind<float WindStrength, float WindSpeed> : IMaterialSurface, PositionStream4, TransformationBase, Global, VelocityOffsetStream
    {
        override void Compute()
        {
        }

        float2 WindOffset(float2 positionWS, float3 position, float time)
        {
            float2 windDirection = float2(0.957826, 0.287348);
            float phase = dot(positionWS, windDirection) * 0.5 + time * WindSpeed;
            float sway = sin(phase) * WindStrength + sin(phase * 2.37 + 1.3) * WindStrength * 0.3;
            float flutter = sin(position.x * 3.7 + position.z * 2.1 + time * WindSpeed * 2.3) * WindStrength * 0.25;

            float height = max(position.y, 0.0);
            return (windDirection * sway + float2(flutter, flutter * 0.5)) * height;
        }

        stage override void TransformPosition()
        {
            base.TransformPosition();

            float2 rest = streams.PositionWS.xz;
            float2 offset = WindOffset(rest, streams.Position.xyz, Time);
            streams.PositionWS.xz += offset;
            float2 previous = WindOffset(rest, streams.Position.xyz, Time - TimeStep) - offset;
            streams.PreviousPositionOffsetWS += float3(previous.x, 0.0, previous.y);
        }
    };
}

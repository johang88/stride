using Stride.Rendering.Materials;

namespace Stride.Terrain
{
    /// <summary>
    /// Feedback pass of the terrain virtual texture: the regular vertex pipeline (material displacement, skinning, instancing)
    /// with a pixel shader writing the requested page.
    /// </summary>
    effect TerrainVTFeedbackEffect
    {
        using params MaterialKeys;

        mixin StrideEffectBase;
        mixin TerrainVTFeedbackShader;
    };
}

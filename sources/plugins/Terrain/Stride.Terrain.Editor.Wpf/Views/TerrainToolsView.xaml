  <!-- A grass layer or vegetation type in a list: the thumbnail of its (first) model and its name -->
  <DataTemplate x:Key="TerrainDefinitionItemTemplate">
    <DockPanel>
      <Border Width="32" Height="32" Margin="0,1,6,1" Background="#20FFFFFF">
        <Image Source="{Binding Thumbnail.Asset.ThumbnailData.Presenter, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </DataTemplate>
  <!-- A terrain material layer: its albedo texture (or tint) with its name under it -->
  <DataTemplate x:Key="TerrainLayerItemTemplate">
    <StackPanel Width="60" Margin="1" ToolTip="{Binding DisplayName}">
      <Border Width="56" Height="56" Background="{Binding Tint, Converter={tv:TerrainTintBrush}}" HorizontalAlignment="Center">
        <Image Source="{Binding Texture.ThumbnailData.Presenter, Mode=OneWay}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="TerrainModelItemTemplate">
    <DockPanel ToolTip="{Binding Asset.Url}">
      <Border Width="24" Height="24" Margin="0,1,6,1" Background="#20FFFFFF">
        <Image Source="{Binding Asset.ThumbnailData.Presenter, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </DataTemplate>

  <!-- The terrain tools panel beside the scene editor's viewport -->
  <DataTemplate DataType="{x:Type te:TerrainToolsViewModel}">
    <StackPanel>
      <TextBlock Text="{Binding TargetName, StringFormat=Target: {0}, TargetNullValue=No terrain in the scene}" TextWrapping="Wrap" Margin="0,0,0,6"/>

      <!-- Tool -->
      <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding Tool}" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Image Source="{Binding Converter={tv:TerrainIcon}}" Width="18" Height="18" Margin="1" ToolTip="{Binding Converter={sd:EnumToDisplayName}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Brush -->
      <DockPanel Margin="0,0,0,2">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Width="30" Height="26" Padding="0" Margin="0,0,3,0" Command="{Binding ImportBrushCommand}" Content="{sd:Image {StaticResource TerrainIcon.ImportBrush}, 16, 16}"
                  ToolTip="{sd:Localize 'Import a brush image (grayscale, or with transparency) into the project', Context=ToolTip}" />
          <Button Width="30" Height="26" Padding="0" Command="{Binding OpenBrushFolderCommand}" Content="{sd:Image {StaticResource TerrainIcon.OpenBrushFolder}, 16, 16}" Margin="0"
                  ToolTip="{Binding BrushFolder}" />
        </StackPanel>
        <TextBlock Text="{Binding SelectedBrush.Name, StringFormat=Brush: {0}}" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox ItemsSource="{Binding Brushes}" SelectedItem="{Binding SelectedBrush}" Margin="0,0,0,8" MaxHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Image Source="{Binding Converter={tv:TerrainBrushPreview}}" Width="32" Height="32" Margin="1" ToolTip="{Binding Name}" RenderOptions.BitmapScalingMode="HighQuality" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{sd:Localize Radius (m)}"/>
      <sd:NumericTextBox Value="{Binding Radius}" Minimum="0.5" Maximum="500" SmallChange="0.5" LargeChange="5" DecimalPlaces="2" Margin="0,2,0,6"/>
      <TextBlock Text="{sd:Localize Strength}"/>
      <sd:NumericTextBox Value="{Binding Strength}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" DecimalPlaces="2" Margin="0,2,0,6"/>
      <StackPanel Visibility="{Binding IsCustomBrush, Converter={sd:VisibleOrCollapsed}, ConverterParameter={sd:False}}">
        <TextBlock Text="{sd:Localize Falloff}"/>
        <sd:NumericTextBox Value="{Binding Falloff}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" DecimalPlaces="2" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsCustomBrush, Converter={sd:VisibleOrCollapsed}}">
        <TextBlock Text="{sd:Localize Rotation (degrees)}"/>
        <sd:NumericTextBox Value="{Binding Rotation}" Minimum="0" Maximum="360" SmallChange="15" LargeChange="45" DecimalPlaces="0" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsFlattenTool, Converter={sd:VisibleOrCollapsed}}">
        <TextBlock Text="{sd:Localize Target height (m)}"/>
        <sd:NumericTextBox Value="{Binding FlattenHeight}" SmallChange="0.1" LargeChange="1" DecimalPlaces="2" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsNoiseTool, Converter={sd:VisibleOrCollapsed}}">
        <TextBlock Text="{sd:Localize Noise feature size (m)}"/>
        <sd:NumericTextBox Value="{Binding NoiseScale}" Minimum="0.1" SmallChange="0.5" LargeChange="5" DecimalPlaces="2" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsGrassTool, Converter={sd:VisibleOrCollapsed}}">
        <DockPanel Margin="0,4,0,2">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" IsEnabled="{Binding CanEditDefinitions}">
            <Button Width="26" Height="22" Padding="0" Margin="0,0,3,0" Command="{Binding AddGrassLayerCommand}"
                    ToolTip="{sd:Localize 'Add a grass layer: pick the plants (models) it grows', Context=ToolTip}">
              <Image Source="{DynamicResource ImageAdd}" Width="16" Height="16"/>
            </Button>
            <Button Width="26" Height="22" Padding="0" Command="{Binding RemoveGrassLayerCommand}"
                    ToolTip="{sd:Localize 'Remove the grass layer and its painted density', Context=ToolTip}">
              <Image Source="{DynamicResource ImageRemove}" Width="16" Height="16"/>
            </Button>
          </StackPanel>
          <TextBlock Text="{sd:Localize Grass layers}" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding GrassLayers}" SelectedItem="{Binding SelectedGrassLayer}" ItemTemplate="{StaticResource TerrainDefinitionItemTemplate}"
                 MaxHeight="190" Margin="0,2,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <TextBlock Text="{sd:Localize 'The terrain is not part of this scene: edit its grass layers in the scene that holds it.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding CanEditDefinitions, Converter={sd:VisibleOrCollapsed}, ConverterParameter={sd:False}}"/>
        <TextBlock Text="{sd:Localize 'No grass layer yet: add one with the plants it grows, then paint it.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding GrassLayers.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:InvertBool}, {sd:VisibleOrCollapsed}}}"/>

        <!-- The selected layer -->
        <StackPanel DataContext="{Binding SelectedGrassLayer}" Visibility="{Binding CanEdit, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}" Margin="8,0,0,4">
          <TextBlock Text="{sd:Localize Name}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6"/>
          <DockPanel Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Width="26" Height="22" Padding="0" Margin="0,0,3,0" Command="{Binding AddModelsCommand}" ToolTip="{sd:Localize 'Add plants (models) to the layer', Context=ToolTip}">
                <Image Source="{DynamicResource ImageAdd}" Width="16" Height="16"/>
              </Button>
              <Button Width="26" Height="22" Padding="0" Command="{Binding RemoveModelCommand}" ToolTip="{sd:Localize 'Remove the plant from the layer', Context=ToolTip}">
                <Image Source="{DynamicResource ImageRemove}" Width="16" Height="16"/>
              </Button>
            </StackPanel>
            <TextBlock Text="{sd:Localize 'Plants (one picked at random per plant)'}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" ItemTemplate="{StaticResource TerrainModelItemTemplate}" MaxHeight="130" Margin="0,2,0,6"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock Text="{sd:Localize Plants per m² (fully painted)}"/>
          <sd:NumericTextBox Value="{Binding Density}" Minimum="0.01" Maximum="64" SmallChange="0.1" LargeChange="1" DecimalPlaces="2" Margin="0,2,0,6"/>
          <TextBlock Text="{sd:Localize Scale}"/>
          <UniformGrid Columns="2" Margin="0,2,0,6">
            <sd:NumericTextBox Value="{Binding MinScale}" Minimum="0.01" Maximum="10" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="0,0,2,0" ToolTip="{sd:Localize Smallest scale}"/>
            <sd:NumericTextBox Value="{Binding MaxScale}" Minimum="0.01" Maximum="10" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="2,0,0,0" ToolTip="{sd:Localize Largest scale}"/>
          </UniformGrid>
          <TextBlock Text="{sd:Localize Draw distance (m)}"/>
          <sd:NumericTextBox Value="{Binding DrawDistance}" Minimum="1" Maximum="500" SmallChange="5" LargeChange="20" DecimalPlaces="0" Margin="0,2,0,6"
                             ToolTip="{sd:Localize 'How far the layer grows from the camera (the game quality settings scale it)', Context=ToolTip}"/>
          <TextBlock Text="{sd:Localize Thins out from (% of the draw distance)}" TextWrapping="Wrap"/>
          <sd:NumericTextBox Value="{Binding ThinOutStartPercent}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" DecimalPlaces="0" Margin="0,2,0,6"
                             ToolTip="{sd:Localize 'From there to the draw distance, fewer and fewer plants remain, each shrinking away before it goes', Context=ToolTip}"/>
          <CheckBox IsChecked="{Binding AlignToTerrain}" Content="{sd:Localize Tilt with the slope}" Margin="0,2,0,4"/>
          <CheckBox IsChecked="{Binding CastShadows}" Content="{sd:Localize Cast shadows}" Margin="0,2,0,6"/>
        </StackPanel>

        <TextBlock Text="{sd:Localize Painting}" FontWeight="Bold" Margin="0,6,0,2"/>
        <TextBlock Text="{sd:Localize Density painted (0-1)}"/>
        <sd:NumericTextBox Value="{Binding GrassDensity}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsFogTool, Converter={sd:VisibleOrCollapsed}}">
        <DockPanel Margin="0,4,0,2">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" IsEnabled="{Binding CanEditDefinitions}">
            <Button Width="26" Height="22" Padding="0" Margin="0,0,3,0" Command="{Binding AddFogLayerCommand}"
                    ToolTip="{sd:Localize 'Add a fog layer', Context=ToolTip}">
              <Image Source="{DynamicResource ImageAdd}" Width="16" Height="16"/>
            </Button>
            <Button Width="26" Height="22" Padding="0" Command="{Binding RemoveFogLayerCommand}"
                    ToolTip="{sd:Localize 'Remove the fog layer and its painted density', Context=ToolTip}">
              <Image Source="{DynamicResource ImageRemove}" Width="16" Height="16"/>
            </Button>
          </StackPanel>
          <TextBlock Text="{sd:Localize Fog layers}" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding FogLayers}" SelectedItem="{Binding SelectedFogLayer}" DisplayMemberPath="DisplayName"
                 MaxHeight="120" Margin="0,2,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <TextBlock Text="{sd:Localize 'The terrain is not part of this scene: edit its fog layers in the scene that holds it.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding CanEditDefinitions, Converter={sd:VisibleOrCollapsed}, ConverterParameter={sd:False}}"/>
        <TextBlock Text="{sd:Localize 'No fog layer yet: add one, then paint it. The fog shows where the scene has a volumetric fog component.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding FogLayers.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:InvertBool}, {sd:VisibleOrCollapsed}}}"/>

        <!-- The selected layer -->
        <StackPanel DataContext="{Binding SelectedFogLayer}" Visibility="{Binding CanEdit, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}" Margin="8,0,0,4">
          <TextBlock Text="{sd:Localize Name}"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6"/>
          <TextBlock Text="{sd:Localize 'Density (fully painted)'}" TextWrapping="Wrap"/>
          <sd:NumericTextBox Value="{Binding Density}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" DecimalPlaces="3" Margin="0,2,0,6"
                             ToolTip="{sd:Localize '0.25 a thin mist (250 m of visibility), 0.5 a ground fog (30 m), 1 about 4 m', Context=ToolTip}"/>
          <TextBlock Text="{sd:Localize Top}"/>
          <ComboBox ItemsSource="{Binding HeightModes}" SelectedItem="{Binding HeightMode}" Margin="0,2,0,2">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={sd:EnumToDisplayName}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <sd:NumericTextBox Value="{Binding Height}" Minimum="-10000" Maximum="10000" SmallChange="0.5" LargeChange="5" DecimalPlaces="1" Margin="0,2,0,6"
                             ToolTip="{sd:Localize 'Height of the fog above the ground, or the altitude it fills the painted valleys up to (meters)', Context=ToolTip}"/>
          <TextBlock Text="{sd:Localize Softness of the top (m)}"/>
          <sd:NumericTextBox Value="{Binding Softness}" Minimum="0.01" Maximum="1000" SmallChange="0.5" LargeChange="2" DecimalPlaces="2" Margin="0,2,0,6"/>
          <TextBlock Text="{sd:Localize Noise (0-1)}"/>
          <sd:NumericTextBox Value="{Binding NoiseStrength}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="0,2,0,6"
                             ToolTip="{sd:Localize 'How much the drifting noise of the scene fog breaks the layer into wisps', Context=ToolTip}"/>
          <TextBlock Text="{sd:Localize 'Colors: select the terrain to edit them in the property grid.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
        </StackPanel>

        <TextBlock Text="{sd:Localize Painting}" FontWeight="Bold" Margin="0,6,0,2"/>
        <TextBlock Text="{sd:Localize Density painted (0-1)}"/>
        <sd:NumericTextBox Value="{Binding FogDensity}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="0,2,0,6"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ShowsTerrainLayers, Converter={sd:VisibleOrCollapsed}}">
        <TextBlock Text="{Binding SelectedLayer.DisplayName, StringFormat=Terrain layer: {0}}" TextTrimming="CharacterEllipsis"/>
        <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" ItemTemplate="{StaticResource TerrainLayerItemTemplate}"
                 MaxHeight="300" Margin="0,2,0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <Button Content="{sd:Localize Fill grass from terrain layer, Context=Button}" Command="{Binding FillGrassFromLayerCommand}" Margin="0,0,0,6"
                Visibility="{Binding IsGrassTool, Converter={sd:VisibleOrCollapsed}}"
                ToolTip="{sd:Localize 'Sets the density of the grass layer over the whole terrain from where the terrain layer is painted (times the density)', Context=ToolTip}" />
      </StackPanel>
      <StackPanel Visibility="{Binding IsVegetationTool, Converter={sd:VisibleOrCollapsed}}">
        <DockPanel Margin="0,4,0,2">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" IsEnabled="{Binding CanEditDefinitions}">
            <Button Width="26" Height="22" Padding="0" Margin="0,0,3,0" Command="{Binding AddVegetationTypesCommand}"
                    ToolTip="{sd:Localize 'Add vegetation types: one per model picked (its levels of detail are the meshes of an FBX LOD group)', Context=ToolTip}">
              <Image Source="{DynamicResource ImageAdd}" Width="16" Height="16"/>
            </Button>
            <Button Width="26" Height="22" Padding="0" Command="{Binding RemoveVegetationTypeCommand}"
                    ToolTip="{sd:Localize 'Remove the vegetation type and its placed instances', Context=ToolTip}">
              <Image Source="{DynamicResource ImageRemove}" Width="16" Height="16"/>
            </Button>
          </StackPanel>
          <TextBlock Text="{sd:Localize Vegetation types}" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding VegetationTypes}" SelectedItem="{Binding SelectedVegetationType}" ItemTemplate="{StaticResource TerrainDefinitionItemTemplate}"
                 SelectionMode="Extended" MaxHeight="190" Margin="0,2,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ToolTip="{sd:Localize 'Ctrl or Shift click to select several types: the tool places a random mix of them', Context=ToolTip}">
          <i:Interaction.Behaviors>
            <sd:ListBoxBindableSelectedItemsBehavior SelectedItems="{Binding SelectedVegetationTypeItems}"/>
          </i:Interaction.Behaviors>
        </ListBox>
        <TextBlock Text="{sd:Localize 'The terrain is not part of this scene: edit its vegetation types in the scene that holds it.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding CanEditDefinitions, Converter={sd:VisibleOrCollapsed}, ConverterParameter={sd:False}}"/>
        <TextBlock Text="{sd:Localize 'No vegetation type yet: add trees or bushes (models), then place them.'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"
                   Visibility="{Binding VegetationTypes.Count, Converter={sd:Chained {sd:NumericToBool}, {sd:InvertBool}, {sd:VisibleOrCollapsed}}}"/>

        <!-- The selected type -->
        <StackPanel DataContext="{Binding SelectedVegetationType}" Margin="8,0,0,4">
          <StackPanel Visibility="{Binding CanEdit, Converter={sd:VisibleOrCollapsed}, FallbackValue={sd:Collapsed}}">
            <TextBlock Text="{sd:Localize Name}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6"/>
            <TextBlock Text="{sd:Localize Model}"/>
            <DockPanel Margin="0,2,0,6">
              <Button Width="26" Height="22" Padding="0" DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding ChangeModelCommand}"
                      ToolTip="{sd:Localize 'Pick another model', Context=ToolTip}">
                <Image Source="{DynamicResource ImagePickup}" Width="16" Height="16"/>
              </Button>
              <ContentPresenter Content="{Binding Model}" ContentTemplate="{StaticResource TerrainModelItemTemplate}"/>
            </DockPanel>
            <TextBlock Text="{sd:Localize Impostor distance (m)}"/>
            <sd:NumericTextBox Value="{Binding ImpostorDistance}" Minimum="0" Maximum="5000" SmallChange="5" LargeChange="20" DecimalPlaces="0" Margin="0,2,0,6"
                               ToolTip="{sd:Localize 'Where impostors replace the meshes (the game quality settings scale it)', Context=ToolTip}"/>
            <TextBlock Text="{sd:Localize Level of detail distances (m)}"/>
            <TextBox Text="{Binding LodDistances, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6"
                     ToolTip="{sd:Localize 'Where each level of detail hands over to the next, nearest first, e.g. 20, 45, 80. Empty: spread up to the impostor distance', Context=ToolTip}"/>
            <TextBlock Text="{sd:Localize Impostor fade range (m)}"/>
            <sd:NumericTextBox Value="{Binding ImpostorFadeRange}" Minimum="0" Maximum="500" SmallChange="1" LargeChange="5" DecimalPlaces="0" Margin="0,2,0,6"
                               ToolTip="{sd:Localize 'Width of the band where meshes and impostors dither into each other', Context=ToolTip}"/>
            <TextBlock Text="{sd:Localize 'Impostor views per side, resolution (px)'}"/>
            <UniformGrid Columns="2" Margin="0,2,0,6">
              <sd:NumericTextBox Value="{Binding ImpostorViews}" Minimum="4" Maximum="16" SmallChange="1" LargeChange="2" DecimalPlaces="0" Margin="0,0,2,0"
                                 ToolTip="{sd:Localize 'More views turn smoother around the impostor (video memory and baking time grow with the square)', Context=ToolTip}"/>
              <sd:NumericTextBox Value="{Binding ImpostorResolution}" Minimum="32" Maximum="1024" SmallChange="32" LargeChange="128" DecimalPlaces="0" Margin="2,0,0,0"
                                 ToolTip="{sd:Localize 'Resolution of each view', Context=ToolTip}"/>
            </UniformGrid>
            <CheckBox IsChecked="{Binding CastShadows}" Content="{sd:Localize Cast shadows}" Margin="0,2,0,4"/>
            <CheckBox IsChecked="{Binding ImpostorsCastShadows}" Content="{sd:Localize Impostors cast shadows}" Margin="0,2,0,6"/>
          </StackPanel>
          <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
        </StackPanel>

        <TextBlock Text="{sd:Localize Placement}" FontWeight="Bold" Margin="0,6,0,2"/>
        <TextBlock Text="{sd:Localize Density (per 100 m²)}"/>
        <sd:NumericTextBox Value="{Binding VegetationDensity}" Minimum="0.01" Maximum="1000" SmallChange="0.5" LargeChange="5" DecimalPlaces="2" Margin="0,2,0,6"/>
        <TextBlock Text="{sd:Localize Spacing (m)}"/>
        <sd:NumericTextBox Value="{Binding VegetationSpacing}" Minimum="0.1" Maximum="100" SmallChange="0.5" LargeChange="2" DecimalPlaces="1" Margin="0,2,0,6"/>
        <TextBlock Text="{sd:Localize Scale}"/>
        <UniformGrid Columns="2" Margin="0,2,0,6">
          <sd:NumericTextBox Value="{Binding VegetationMinScale}" Minimum="0.01" Maximum="100" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="0,0,2,0" ToolTip="{sd:Localize Smallest scale}"/>
          <sd:NumericTextBox Value="{Binding VegetationMaxScale}" Minimum="0.01" Maximum="100" SmallChange="0.05" LargeChange="0.25" DecimalPlaces="2" Margin="2,0,0,0" ToolTip="{sd:Localize Largest scale}"/>
        </UniformGrid>
        <TextBlock Text="{sd:Localize Steepest slope (degrees)}"/>
        <sd:NumericTextBox Value="{Binding VegetationMaxSlope}" Minimum="0" Maximum="90" SmallChange="1" LargeChange="5" DecimalPlaces="0" Margin="0,2,0,6"/>
        <CheckBox IsChecked="{Binding ImpostorPreview}" Content="{sd:Localize Show impostors only}" Margin="0,2,0,6"
                  ToolTip="{sd:Localize 'Draws the vegetation as impostors at any distance, to check them', Context=ToolTip}" />
      </StackPanel>
      <Button Content="{sd:Localize All terrain settings, Context=Button}" Command="{Binding SelectTerrainCommand}" HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,6"
              Visibility="{Binding HasTarget, Converter={sd:VisibleOrCollapsed}}"
              ToolTip="{sd:Localize 'Selects the terrain entity: the property grid shows all its settings, grass layers and vegetation types included', Context=ToolTip}"/>
      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,8"/>

      <DockPanel Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Width="30" Height="26" Padding="0" Margin="0,0,3,0" Command="{Binding ImportHeightmapCommand}" Content="{sd:Image {StaticResource TerrainIcon.ImportHeightmap}, 16, 16}"
                  ToolTip="{sd:Localize 'Import a height map (16-bit PNG, TIFF, DDS or raw .r16), stretched over the terrain height range', Context=ToolTip}" />
          <Button Width="30" Height="26" Padding="0" Command="{Binding ExportHeightmapCommand}" Content="{sd:Image {StaticResource TerrainIcon.ExportHeightmap}, 16, 16}" Margin="0"
                  ToolTip="{sd:Localize 'Export the height map (raw 16-bit .r16)', Context=ToolTip}" />
        </StackPanel>
        <TextBlock Text="{sd:Localize Height map}" FontWeight="Bold" VerticalAlignment="Center" />
      </DockPanel>

      <TextBlock Text="{sd:Localize Splines}" FontWeight="Bold" Margin="0,12,0,4"/>
      <TextBlock Text="{sd:Localize 'Roads and rivers are entities with a terrain spline component; their child entities are the control points (X scale sets the width).'}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,6"/>
      <StackPanel Orientation="Horizontal">
        <Button Width="30" Height="26" Padding="0" Margin="0,0,3,0" Command="{Binding NewRoadCommand}" Content="{sd:Image {StaticResource TerrainIcon.NewRoad}, 16, 16}"
                ToolTip="{sd:Localize 'New road at the center of the view', Context=ToolTip}" />
        <Button Width="30" Height="26" Padding="0" Margin="0,0,3,0" Command="{Binding NewRiverCommand}" Content="{sd:Image {StaticResource TerrainIcon.NewRiver}, 16, 16}"
                ToolTip="{sd:Localize 'New river at the center of the view', Context=ToolTip}" />
        <Button Width="30" Height="26" Padding="0" Command="{Binding SnapSplinePointsCommand}" Content="{sd:Image {StaticResource TerrainIcon.SnapSplinePoints}, 16, 16}" Margin="9,0,3,0"
                ToolTip="{sd:Localize 'Snap spline points to the terrain: moves the control points of the selected splines (or all of them when none is selected) onto the terrain surface', Context=ToolTip}" />
        <Button Width="30" Height="26" Padding="0" Margin="0,0,3,0" Command="{Binding ApplySplinesCommand}" Content="{sd:Image {StaticResource TerrainIcon.ApplySplines}, 16, 16}"
                ToolTip="{sd:Localize 'Apply splines to the terrain: flattens, carves and paints the terrain along the selected splines (or all of them when none is selected)', Context=ToolTip}" />
      </StackPanel>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>

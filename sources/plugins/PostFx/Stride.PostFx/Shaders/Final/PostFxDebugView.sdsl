namespace Stride.PostFx
{
    /// <summary>
    /// Shows a buffer of the renderer: a single channel one (ambient occlusion, contact shadows) in grey, or light found on
    /// screen (exposed, weighted by its confidence; DebugPremultiplied: already weighted). Texture0 = the buffer.
    /// </summary>
    shader PostFxDebugView : ImageEffectShader
    {
        stage bool DebugColor;
        stage float DebugScale;
        stage bool DebugPremultiplied;

        stage override float4 Shading()
        {
            float4 value = Texture0.SampleLevel(PointSampler, streams.TexCoord, 0);
            if (DebugColor)
            {
                float3 light = value.rgb * (DebugPremultiplied ? 1.0 : value.a) * DebugScale;
                return float4(pow(saturate(light / (1.0 + light)), 1.0 / 2.2), 1.0);
            }
            return float4(value.r, value.r, value.r, 1.0);
        }
    };
}

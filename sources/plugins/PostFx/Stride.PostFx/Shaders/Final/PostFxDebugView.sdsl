namespace Stride.PostFx
{
    /// <summary>
    /// Shows a single channel buffer (ambient occlusion, contact shadows) in grey. Texture0 = the buffer.
    /// </summary>
    shader PostFxDebugView : ImageEffectShader
    {
        stage override float4 Shading()
        {
            float value = Texture0.SampleLevel(PointSampler, streams.TexCoord, 0).r;
            return float4(value, value, value, 1.0);
        }
    };
}

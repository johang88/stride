namespace Stride.PostFx
{
    /// <summary>
    /// Accumulates the screen-space indirect light over frames: this frame's rays (blurred over a few pixels of the same
    /// surface) blended into the history reprojected by the camera. rgb = the light of the hits (averaged over them only),
    /// a = the share of rays that hit something. Groups of 8x8 threads.
    /// </summary>
    shader PostFxIndirectTemporal : ComputeShaderBase, PostFxViewSpace
    {
        stage Texture2D<float4> IndirectCurrent;
        stage Texture2D<float4> IndirectHistory;
        stage Texture2D<float> IndirectTemporalDistance;
        stage RWTexture2D<float4> IndirectAccumulated;

        stage SamplerState IndirectHistorySampler
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        cbuffer PerDispatch
        {
            stage int2 IndirectTemporalSize;
            // Current (jittered) clip space to the world, the world to the previous frame's clip space
            stage float4x4 IndirectInverseViewProjection;
            stage float4x4 IndirectPreviousViewProjection;
            stage float IndirectHistoryValid;
        };

        override void Compute()
        {
            int2 pixel = (int2)streams.DispatchThreadId.xy;
            if (any(pixel >= IndirectTemporalSize))
                return;
            float center = IndirectTemporalDistance.Load(int3(pixel * 2, 0));
            if (center > 5000.0)
            {
                IndirectAccumulated[pixel] = 0.0;
                return;
            }

            // This frame: the rays of the 3x3 neighbours on the same surface
            float3 light = 0.0;
            float hits = 0.0;
            float samples = 0.0;
            [unroll]
            for (int y = -1; y <= 1; y++)
            {
                [unroll]
                for (int x = -1; x <= 1; x++)
                {
                    int2 tap = clamp(pixel + int2(x, y), int2(0, 0), IndirectTemporalSize - 1);
                    float distance = IndirectTemporalDistance.Load(int3(tap * 2, 0));
                    float w = saturate(1.0 - abs(distance - center) / (center * 0.05 + 0.05));
                    float4 ray = IndirectCurrent.Load(int3(tap, 0));
                    light += ray.rgb * ray.a * w;
                    hits += ray.a * w;
                    samples += w;
                }
            }
            float4 current = float4(hits > 0.0 ? light / hits : 0.0, hits / max(samples, 1e-4));

            // Where this surface was
            float2 uv = (pixel * 2 + 1.0) * ViewSize.zw;
            float depth = ViewDepthInfo.y / center - ViewDepthInfo.x;
            float4 world = mul(float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0), IndirectInverseViewProjection);
            float4 previousClip = mul(world, IndirectPreviousViewProjection);
            float2 previousUv = float2(previousClip.x / previousClip.w * 0.5 + 0.5, 0.5 - previousClip.y / previousClip.w * 0.5);
            bool inside = IndirectHistoryValid > 0.5 && previousClip.w > 0.0 && all(previousUv > 0.0) && all(previousUv < 1.0);
            if (!inside)
            {
                IndirectAccumulated[pixel] = current;
                return;
            }
            float4 history = IndirectHistory.SampleLevel(IndirectHistorySampler, previousUv, 0);
            // The light blended by the hits each brings (a miss doesn't darken the light found before)
            float blend = 0.08;
            float hitShare = lerp(history.a, current.a, blend);
            float3 blended = (history.rgb * history.a * (1.0 - blend) + current.rgb * current.a * blend) / max(hitShare, 1e-4);
            IndirectAccumulated[pixel] = float4(hitShare > 0.0 ? blended : 0.0, hitShare);
        }
    };
}

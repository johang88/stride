namespace Stride.PostFx
{
    /// <summary>
    /// The screen-space lighting terms of the view on an opaque surface (a mixin of the forward shading, see
    /// ForwardShadingKeys.ScreenSpaceLighting): ambient occlusion on the light from around (the sky, the probes), and the
    /// reflected and indirect light found on screen the frame before (reprojected), which the sky light blends towards.
    /// </summary>
    shader PostFxScreenSpaceLighting : MaterialPixelShadingStream, ShaderBaseStream, PositionStream4
    {
        rgroup PerView.PostFxScreenSpace
        {
            stage Texture2D PostFxAmbientOcclusion;
            stage Texture2D PostFxReflections;
            stage Texture2D PostFxIndirect;
        }

        cbuffer PerView.PostFxScreenSpace
        {
            // Size of the view (pixels), and its inverse
            stage float4 PostFxScreenSize;
            // World to the previous frame's clip space (for the reflections and indirect light traced then)
            stage float4x4 PostFxPreviousViewProjection;
            stage float PostFxAmbientOcclusionStrength;
            stage float PostFxReflectionStrength;
            stage float PostFxReflectionMaxRoughness;
            stage float PostFxIndirectStrength;
        }

        stage SamplerState PostFxScreenLinear
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        stage override void ApplyScreenSpaceLighting()
        {
            base.ApplyScreenSpaceLighting();
            float2 uv = streams.ShadingPosition.xy * PostFxScreenSize.zw;
            // (the material's own occlusion: the indirect light found on screen has the screen's occlusion in it already)
            float materialOcclusion = streams.matAmbientOcclusion;
            float screenOcclusion = 1.0;

            if (PostFxAmbientOcclusionStrength > 0.0)
            {
                // (half on thin surfaces: a blade or leaf takes light through both faces, the occlusion only saw around the
                // one facing the eye)
                float strength = PostFxAmbientOcclusionStrength * (1.0 - 0.5 * saturate(streams.matThinSurface));
                float occlusion = lerp(1.0, PostFxAmbientOcclusion.SampleLevel(PostFxScreenLinear, uv, 0).r, strength);
                // The light bouncing around within the occluded spots (Jimenez et al. 2016: bright surfaces darken less)
                float albedo = dot(streams.matDiffuseVisible, float3(0.2126, 0.7152, 0.0722));
                float a = 2.0404 * albedo - 0.3324;
                float b = -4.7951 * albedo + 0.6417;
                float c = 2.7552 * albedo + 0.6903;
                occlusion = max(occlusion, ((occlusion * a + b) * occlusion + c) * occlusion);
                streams.matAmbientOcclusion *= occlusion;
                screenOcclusion = occlusion;
            }

            if (PostFxReflectionStrength > 0.0 || PostFxIndirectStrength > 0.0)
            {
                // Where this surface was on screen the frame before
                float4 previousClip = mul(float4(streams.PositionWS.xyz, 1.0), PostFxPreviousViewProjection);
                float2 previousUv = float2(previousClip.x / previousClip.w * 0.5 + 0.5, 0.5 - previousClip.y / previousClip.w * 0.5);
                float2 edge = saturate(min(previousUv, 1.0 - previousUv) * 16.0);
                float onScreen = previousClip.w > 0.0 ? edge.x * edge.y : 0.0;
                // (the indirect light holds up to the edge: only what was off screen the frame before has none)
                float2 indirectEdge = saturate(min(previousUv, 1.0 - previousUv) * PostFxScreenSize.xy * 0.125);
                float indirectOnScreen = previousClip.w > 0.0 ? indirectEdge.x * indirectEdge.y : 0.0;

                if (PostFxReflectionStrength > 0.0)
                {
                    // (resolved for this surface's lobe already; premultiplied by the confidence, so filtering across the
                    // edge of what was found keeps its light. Fading to the sky's below the roughest surface traced)
                    float4 reflection = PostFxReflections.SampleLevel(PostFxScreenLinear, previousUv, 0);
                    float3 light = reflection.rgb / max(reflection.a, 1e-4);
                    float roughness = sqrt(streams.alphaRoughness);
                    float traced = saturate((PostFxReflectionMaxRoughness - roughness) * 10.0);
                    streams.screenSpaceSpecular = float4(light, saturate(reflection.a * onScreen * PostFxReflectionStrength * traced));
                }
                if (PostFxIndirectStrength > 0.0)
                {
                    // (premultiplied by the share of rays that found light, so filtering between pixels that found some and
                    // pixels that didn't keeps the light found)
                    float4 indirect = PostFxIndirect.SampleLevel(PostFxScreenLinear, previousUv, 0);
                    float3 light = indirect.rgb / max(indirect.a, 1e-4);
                    float found = saturate(indirect.a * indirectOnScreen * PostFxIndirectStrength);
                    // The sky's light comes through where the rays found nothing. The ambient occlusion sees the same
                    // surroundings (multiplied, both would darken for the same blades): it only darkens the sky's light
                    // further where it finds more of it hidden than the rays did
                    float sky = min(screenOcclusion, 1.0 - found) / max(screenOcclusion, 1e-4);
                    streams.screenSpaceDiffuse = float4(light * materialOcclusion * found, sky);
                }
            }
        }
    };
}

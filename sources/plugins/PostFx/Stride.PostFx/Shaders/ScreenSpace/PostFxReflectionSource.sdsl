namespace Stride.PostFx
{
    /// <summary>
    /// The light the reflections read, at half the view's resolution (mips follow, PostFxScreenMip): the anti-aliased image
    /// averaged over each 2x2 of the view's pixels, without NaNs, the brightest light limited (a highlight caught in a
    /// rough reflection would sparkle). Groups of 8x8 threads. Output: rgb = light, a = the closest distance in front of the
    /// camera in the 2x2 (the pyramid's level 1): next frame's transparent reflections check that a hit was visible here.
    /// </summary>
    shader PostFxReflectionSource : ComputeShaderBase, PostFxCommon
    {
        stage Texture2D SourceScene;
        // The distance pyramid's level at the source's resolution
        stage Texture2D SourceDistance;
        stage RWTexture2D<float4> SourceOutput;

        stage SamplerState SourceLinearClamp
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        cbuffer PerDispatch
        {
            stage int2 SourceSize;
            // The brightest light kept (scene light)
            stage float SourceMaxLuminance;
        };

        override void Compute()
        {
            int2 texel = (int2)streams.DispatchThreadId.xy;
            if (any(texel >= SourceSize))
                return;
            float2 uv = (texel + 0.5) / SourceSize;
            float3 light = SourceScene.SampleLevel(SourceLinearClamp, uv, 0).rgb;
            light = any(isnan(light)) ? 0.0 : max(light, 0.0);
            light *= min(1.0, SourceMaxLuminance / max(PostFxLuminance(light), 1e-6));
            int2 distanceSize;
            SourceDistance.GetDimensions(distanceSize.x, distanceSize.y);
            float closest = SourceDistance.Load(int3(min(texel, distanceSize - 1), 0)).r;
            SourceOutput[texel] = float4(light, closest);
        }
    };
}

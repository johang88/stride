namespace Stride.PostFx
{
    /// <summary>
    /// Screen-space indirect light, at half resolution: two rays per pixel and frame in a cosine distribution about the
    /// normal (from the depth), marched a short way through the view's distances and refined where it goes behind a
    /// surface; a hit takes the light leaving the surface it found in the anti-aliased image (limited, so a ray finding a
    /// highlight doesn't sparkle), a miss leaves the direction to the sky. Accumulated over frames by
    /// PostFxIndirectTemporal, filtered by PostFxIndirectFilter. Groups of 8x8 threads.
    /// Output: rgb = light found (averaged over the rays that hit something), a = share of the rays that hit something; the
    /// normal (view space) and the distance of the pixel, for the filter.
    /// </summary>
    shader PostFxIndirect : ComputeShaderBase, PostFxViewSpace, PostFxCommon
    {
        stage Texture2D<float> IndirectDistance;
        stage Texture2D IndirectScene;
        stage RWTexture2D<float4> IndirectOutput;
        stage RWTexture2D<float4> IndirectNormal;

        stage SamplerState IndirectPointClamp
        {
            Filter = MIN_MAG_MIP_POINT;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        stage SamplerState IndirectLinearClamp
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        cbuffer PerDispatch
        {
            stage int2 IndirectSize;
            // Farthest the light is looked for (meters)
            stage float IndirectMaxDistance;
            stage int IndirectSteps;
            stage float IndirectFrame;
            // Scene light to screen brightness (the exposure), and the brightest light a hit brings, on screen
            stage float IndirectExposure;
            stage float IndirectMaxBrightness;
        };

        override void Compute()
        {
            int2 pixel = (int2)streams.DispatchThreadId.xy;
            if (any(pixel >= IndirectSize))
                return;
            int2 full = pixel * 2;
            float2 texel = ViewSize.zw;
            float distance = IndirectDistance.Load(int3(full, 0));
            if (IsSky(distance))
            {
                IndirectOutput[pixel] = 0.0;
                IndirectNormal[pixel] = float4(0.0, 0.0, 1.0, distance);
                return;
            }

            float3 position = ViewPosition((full + 0.5) * texel, distance);
            float3 left = ViewPosition((full + float2(-0.5, 0.5)) * texel, IndirectDistance.Load(int3(full - int2(1, 0), 0)));
            float3 right = ViewPosition((full + float2(1.5, 0.5)) * texel, IndirectDistance.Load(int3(full + int2(1, 0), 0)));
            float3 up = ViewPosition((full + float2(0.5, -0.5)) * texel, IndirectDistance.Load(int3(full - int2(0, 1), 0)));
            float3 down = ViewPosition((full + float2(0.5, 1.5)) * texel, IndirectDistance.Load(int3(full + int2(0, 1), 0)));
            float3 dx = abs(right.z - position.z) < abs(position.z - left.z) ? right - position : position - left;
            float3 dy = abs(down.z - position.z) < abs(position.z - up.z) ? down - position : position - up;
            float3 normal = normalize(cross(dy, dx));
            if (dot(normal, -position) < 0.0)
                normal = -normal;
            IndirectNormal[pixel] = float4(normal, distance);

            float3 tangent = normalize(abs(normal.y) < 0.99 ? cross(normal, float3(0, 1, 0)) : cross(normal, float3(1, 0, 0)));
            float3 bitangent = cross(normal, tangent);
            float3 origin = position + normal * (0.02 + 0.002 * distance);
            float3 light = 0.0;
            float hits = 0.0;
            [unroll]
            for (int ray = 0; ray < 2; ray++)
            {
                // (the second ray: the pixel's values of another frame of the sequence)
                float4 found = Trace(origin, normal, tangent, bitangent, PostFxFrameNoise3(pixel, IndirectFrame + ray * 512.0));
                light += found.rgb;
                hits += found.a;
            }
            IndirectOutput[pixel] = float4(hits > 0.0 ? light / hits : 0.0, hits * 0.5);
        }

        // A ray in a cosine distributed direction about the normal (noise: the direction, and where along the first step the
        // march starts): rgb = the light it found, a = 1 if it hit something
        stage float4 Trace(float3 origin, float3 normal, float3 tangent, float3 bitangent, float3 noise)
        {
            float r = sqrt(noise.x);
            float phi = 6.2831853 * noise.y;
            float3 direction = normalize(tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + normal * sqrt(saturate(1.0 - noise.x)));

            float growth = pow(IndirectMaxDistance / 0.05, 1.0 / IndirectSteps);
            float previousT = 0.0;
            float t = 0.05 * (1.0 + noise.z * (growth - 1.0));
            for (int i = 0; i < IndirectSteps; i++)
            {
                float3 sample = origin + direction * t;
                if (sample.z <= 0.05)
                    break;
                float2 sampleUv = ViewToUv(sample);
                if (any(sampleUv < 0.0) || any(sampleUv > 1.0))
                    break;
                float scene = IndirectDistance.SampleLevel(IndirectPointClamp, sampleUv, 1);
                if (sample.z > scene)
                {
                    // Behind a surface since the last step: where the ray met it (a hit taken at the step itself jumps
                    // from step to step across neighbouring pixels, which drew bands)
                    float nearT = previousT;
                    float farT = t;
                    [unroll]
                    for (int refine = 0; refine < 5; refine++)
                    {
                        float middleT = 0.5 * (nearT + farT);
                        float3 middle = origin + direction * middleT;
                        if (middle.z > IndirectDistance.SampleLevel(IndirectPointClamp, ViewToUv(middle), 0))
                            farT = middleT;
                        else
                            nearT = middleT;
                    }
                    float3 hit = origin + direction * farT;
                    float2 hitUv = ViewToUv(hit);
                    float behind = hit.z - IndirectDistance.SampleLevel(IndirectPointClamp, hitUv, 0);
                    // A surface there, not the gap behind a thin one (then the ray goes on)
                    if (behind < 0.15 + 0.03 * hit.z + (farT - nearT) * 2.0)
                    {
                        float3 light = IndirectScene.SampleLevel(IndirectLinearClamp, hitUv, 0).rgb;
                        light = any(isnan(light)) ? 0.0 : max(light, 0.0);
                        float brightness = PostFxLuminance(light) * IndirectExposure;
                        light *= min(1.0, IndirectMaxBrightness / max(brightness, 1e-6));
                        return float4(light, 1.0);
                    }
                }
                previousT = t;
                t *= growth;
            }
            return 0.0;
        }
    };
}

namespace Stride.PostFx
{
    /// <summary>
    /// Contact shadows on the surfaces lit by the light they were traced for, combined with its shadow maps (a directional
    /// shadow receiver extension): read at the pixel being shaded.
    /// </summary>
    shader PostFxContactShadowReceiver : ShadowGroup, ShaderBaseStream
    {
        rgroup PerView.Lighting
        {
            Texture2D ContactShadowTexture;
        }

        cbuffer PerView.Lighting
        {
            // x = strength (0: none), zw = inverse size of the view (pixels)
            float4 ContactShadowScreen;
            // Index of the light in its group (-1: none of them)
            int ContactShadowLightIndex;
        }

        stage SamplerState ContactShadowSampler
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        override float3 ComputeShadow(float3 position, int lightIndex)
        {
            float3 shadow = base.ComputeShadow(position, lightIndex);
            if (lightIndex != ContactShadowLightIndex || ContactShadowScreen.x <= 0.0)
                return shadow;
            float contact = ContactShadowTexture.SampleLevel(ContactShadowSampler, streams.ShadingPosition.xy * ContactShadowScreen.zw, 0).r;
            return shadow * lerp(1.0, contact, ContactShadowScreen.x);
        }
    };
}

namespace Stride.Water
{
    /// <summary>
    /// The water between the surface and the opaque scene behind it, before lighting (MaterialTransparencyWaterFeature):
    /// the scene seen through the surface, displaced by its normal (refraction; objects in front of the water are left out),
    /// how much of it gets through the water (Beer-Lambert extinction over the light's path down to the floor and up
    /// along the refracted view), and the fade at
    /// the shoreline. The in-scattered light builds up where the scene's light doesn't get through: the material's diffuse
    /// color (the water's scattering albedo) is scaled by the opacity, then lit like any surface.
    /// Needs the scene depth and color during the transparent stage (ForwardRenderer.BindDepthAsResourceDuringTransparentRendering
    /// and BindOpaqueAsResourceDuringTransparentRendering).
    /// </summary>
    shader MaterialWaterVolume : IMaterialSurfacePixel, MaterialPixelStream, NormalStream, WaterSceneDepth, OpaqueBase, WaterVolumeStream
    {
        cbuffer PerMaterial
        {
            // Extinction coefficient per channel (1/m)
            stage float3 WaterExtinction;
            // 1 / depth (m) over which the water fades in from the shoreline
            stage float WaterEdgeFade;
            // Displacement (m) of the scene seen through a surface tilted by 45 degrees
            stage float WaterRefraction;
            // 1 / depth (m) at which the refraction reaches its full displacement
            stage float WaterRefractionDepth;
        }

        override void Compute()
        {
            float3 positionWS = streams.PositionWS.xyz;
            int2 pixel = int2(streams.ShadingPosition.xy);
            float2 size = WaterSceneSize();
            float2 uv = streams.ShadingPosition.xy / size;
            float3 surfaceVS = mul(float4(positionWS, 1.0), View).xyz;
            float surfaceDepth = -surfaceVS.z;

            float sceneDepth = WaterSceneDepthAt(pixel);
            float3 sceneWS = WaterScenePositionWS(surfaceVS, sceneDepth);
            float floorDepth = positionWS.y - sceneWS.y;
            streams.waterEdge = smoothstep(0.0, 1.0, saturate(floorDepth * WaterEdgeFade));

            // The surface's tilt from its geometric normal, in the view plane
            float3 normalWS = normalize(mul(streams.matNormal, streams.tangentToWorld));
            float3 tilt = mul(normalWS - normalize(streams.meshNormalWS), (float3x3)View);
            float displacement = WaterRefraction * saturate(floorDepth * WaterRefractionDepth);
            float2 offset = tilt.xy * displacement * float2(Projection._11, -Projection._22) * 0.5;
            if (!WaterIsOrthographic())
                offset /= max(surfaceDepth, 0.1);

            float2 refractedUV = uv + offset;
            float refractedDepth = WaterSceneDepthAtUV(refractedUV);
            // (what's in front of the surface isn't under the water: keep the straight view there)
            if (refractedDepth < surfaceDepth || any(refractedUV != saturate(refractedUV)))
            {
                refractedUV = uv;
                refractedDepth = sceneDepth;
            }
            float3 refractedWS = WaterScenePositionWS(surfaceVS, refractedDepth);
            // The light seen through the water travelled down to the floor first (mostly from above), then up along the view
            float path = length(refractedWS - positionWS) + max(positionWS.y - refractedWS.y, 0.0) * 1.2;

            streams.waterTransmittance = exp(-WaterExtinction * path);
            streams.waterRefracted = OpaqueRenderTarget.SampleLevel(LinearSampler, refractedUV, 0.0).rgb;
            streams.waterBackground = OpaqueRenderTarget.Load(int3(pixel, 0)).rgb;

            streams.matDiffuse.rgb *= 1.0 - streams.waterTransmittance;
        }
    };
}

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:be="clr-namespace:Stride.Blockout.Editor;assembly=Stride.Blockout.Editor"
                    xmlns:bv="clr-namespace:Stride.Blockout.Editor.Views"
                    xmlns:sd="http://schemas.stride3d.net/xaml/presentation">
  <!-- Toolbar icon (16x16, in the light palette of the editor icons: the editor themes them): a box and a ramp -->
  <DrawingImage x:Key="BlockoutIcon.Tool">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="F1M0,0L16,0 16,16 0,16z" />
        <GeometryDrawing Brush="#FFC27D1A" Geometry="F1M0.5,15L9,15 9,10.5z" />
        <GeometryDrawing Brush="#FF424242" Geometry="F1M6,4.5L10,2.5 15.5,4.5 15.5,12.5 11.5,14.5 6,12.5z" />
        <GeometryDrawing Brush="#FFF6F6F6" Geometry="F1M7,5L10,3.6 14.2,5 11.4,6.4z" />
        <GeometryDrawing Brush="#FF1BA1E2" Geometry="F1M12,7.2L14.8,5.8 14.8,12.1 12,13.5z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- The blockout tools panel beside the scene editor's viewport -->
  <DataTemplate DataType="{x:Type be:BlockoutToolsViewModel}">
    <StackPanel>
      <!-- Shapes -->
      <TextBlock Text="Shapes" FontWeight="Bold" Margin="0,0,0,2"/>
      <ListBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" Margin="0,0,0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="56" Margin="1,2" ToolTip="{Binding ToolTip}">
              <Image Source="{Binding Converter={bv:BlockoutShapeThumbnail}}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Grid -->
      <DockPanel Margin="0,0,0,10">
        <TextBlock Text="m" VerticalAlignment="Center" Margin="3,0,0,0" DockPanel.Dock="Right"/>
        <ComboBox ItemsSource="{Binding GridSizes}" SelectedItem="{Binding GridSize}" Width="70" DockPanel.Dock="Right"
                  ToolTip="Grid spacing: positions and sizes of the shapes drawn and resized snap to it"/>
        <CheckBox IsChecked="{Binding Snap}" Content="Snap to grid" VerticalAlignment="Center"
                  ToolTip="Snap positions and sizes to the grid (Shift toggles it while drawing and resizing)"/>
      </DockPanel>

      <!-- Style -->
      <TextBlock Text="Style" FontWeight="Bold" Margin="0,0,0,2"/>
      <DockPanel Margin="0,0,0,6">
        <Border BorderThickness="1" BorderBrush="#80808080" DockPanel.Dock="Left" Margin="0,0,6,0">
          <Image Source="{Binding CurrentLook, Converter={bv:BlockoutLookPreview}}" Width="28" Height="28" />
        </Border>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="New shapes: " /><Run Text="{Binding CurrentStyleName, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
      </DockPanel>
      <TextBlock Text="Presets, patterns and colors apply to new shapes and to the selected ones." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4"/>

      <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,2">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    Padding="2" Margin="1" Width="58" ToolTip="{Binding Name}">
              <StackPanel>
                <Border x:Name="Frame" BorderThickness="2" BorderBrush="Transparent" HorizontalAlignment="Center">
                  <Image Source="{Binding Look, Converter={bv:BlockoutLookPreview}}" Width="36" Height="36" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#FF1BA1E2" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="New preset" Padding="6,1" Margin="0,0,3,0" Command="{Binding AddPresetCommand}"
                ToolTip="A new preset with the style of new shapes"/>
        <Button Content="Remove" Padding="6,1" Margin="0,0,3,0" Command="{Binding RemovePresetCommand}"
                ToolTip="Removes the preset edited below (shapes keep their look)"/>
        <Button Content="Pick from selection" Padding="6,1" Command="{Binding PickStyleFromSelectionCommand}"
                ToolTip="New shapes take the style of the selected shape"/>
      </StackPanel>

      <TextBlock Text="Pattern" Margin="0,0,0,2"/>
      <ItemsControl ItemsSource="{Binding Patterns}" Margin="0,0,0,6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.SetPatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    Padding="1" Margin="1" ToolTip="{Binding}">
              <Image Source="{Binding Converter={bv:BlockoutLookPreview}}" Width="26" Height="26" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Color" Margin="0,0,0,2"/>
      <ItemsControl ItemsSource="{Binding Colors}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                    Padding="1" Margin="1" ToolTip="{Binding Name}">
              <Rectangle Width="20" Height="20" Fill="{Binding Color, Converter={bv:BlockoutColorBrush}}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The preset last applied -->
      <Expander Header="{Binding SelectedPreset.Name}" HeaderStringFormat="Edit preset: {0}" Margin="0,0,0,8"
                Visibility="{Binding HasSelectedPreset, Converter={sd:VisibleOrCollapsed}}">
        <StackPanel DataContext="{Binding SelectedPreset}" Margin="4,4,0,0">
          <TextBlock Text="Changes apply to the shapes of the scene that use the preset." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4"/>
          <TextBlock Text="Name"/>
          <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,6"/>
          <TextBlock Text="Pattern"/>
          <ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding Pattern}" Margin="0,2,0,6"/>
          <TextBlock Text="Color"/>
          <Grid Margin="0,2,0,6">
            <ToggleButton x:Name="PresetColorButton" HorizontalAlignment="Left" Width="60" Height="22" Padding="2">
              <Rectangle Fill="{Binding Color, Converter={bv:BlockoutColorBrush}}" Width="52" Height="16" />
            </ToggleButton>
            <Popup IsOpen="{Binding IsChecked, ElementName=PresetColorButton}" StaysOpen="False" PlacementTarget="{Binding ElementName=PresetColorButton}">
              <Grid Background="{StaticResource BackgroundBrush}" MinWidth="220" MinHeight="220">
                <sd:ColorPicker Color="{Binding PickerColor}" ShowAlpha="False" />
              </Grid>
            </Popup>
          </Grid>
          <TextBlock Text="Pattern size (m)"/>
          <sd:NumericTextBox Value="{Binding Scale}" Minimum="0.05" Maximum="100" SmallChange="0.25" LargeChange="1" DecimalPlaces="2" Margin="0,2,0,6"/>
          <TextBlock Text="Contrast"/>
          <sd:NumericTextBox Value="{Binding Contrast}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" DecimalPlaces="2" Margin="0,2,0,6"/>
          <TextBlock Text="Roughness"/>
          <sd:NumericTextBox Value="{Binding Roughness}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" DecimalPlaces="2" Margin="0,2,0,2"/>
        </StackPanel>
      </Expander>

      <!-- Selection -->
      <TextBlock Text="Selection" FontWeight="Bold" Margin="0,0,0,2"/>
      <TextBlock Text="{Binding SelectionInfo}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Drop to ground" Padding="6,1" Margin="0,0,3,0" Command="{Binding DropToGroundCommand}"
                ToolTip="Moves the selected entities down onto the surface below them"/>
        <Button Content="Turn 90°" Padding="6,1" Command="{Binding RotateSelectionCommand}"
                ToolTip="Turns the selected entities a quarter turn around the vertical axis"/>
      </StackPanel>
      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>

namespace Stride.Atmosphere.Fog
{
    /// <summary>
    /// Fogs the shading of transparent surfaces (the opaque ones are fogged in a full-screen pass before them): the fog in
    /// front of the surface, weighted by its coverage.
    /// </summary>
    shader VolumetricFogShading : ShadingBase, VolumetricFogApplyBase, Transformation, PositionStream4
    {
        stage override float4 Shading()
        {
            float4 color = base.Shading();

            float3 position = streams.PositionWS.xyz;
            float4 clip = mul(float4(position, 1.0), ViewProjection);
            float2 uv = clip.xy / clip.w * float2(0.5, -0.5) + 0.5;
            float depth = -mul(float4(position, 1.0), View).z;
            float4 fog = EvaluateFog(uv, depth, position - Eye.xyz, 0.5, true);

            // Premultiplied coverage: the fog replaces the share of the background the surface hides
            color.rgb = color.rgb * fog.a + fog.rgb * color.a;
            return color;
        }
    };
}

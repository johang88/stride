namespace Stride.Atmosphere.Fog
{
    /// <summary>
    /// Evaluates the media between the camera and a point: the integrated froxel volume up to its distance, then the height fog
    /// integrated analytically beyond it, lit by the unshadowed sun and by the sky in the direction of the view (its blurred
    /// cube map: distant fog takes the color of the sky at the horizon behind it), and the atmosphere's aerial perspective
    /// behind them.
    /// </summary>
    shader VolumetricFogApplyBase : VolumetricFogCommon
    {
        rgroup PerView.VolumetricFog
        {
            stage Texture3D<float4> FogIntegrated;
            stage TextureCube<float4> FogSkyCubeMap;
            stage Texture3D<float4> FogAerialPerspective;
        }

        cbuffer PerView.VolumetricFog
        {
            // Grid of the volume (see VolumetricFogCommon)
            stage float4 FogApplyGrid;
            // Height fog: x = density at the base height, y = falloff, z = base height, w = 1 when the volume holds the fog up to its distance
            stage float4 FogApplyHeight;
            // rgb = sky light scattered evenly (without the sky cube map), w = 1 when there is any fog
            stage float4 FogApplyAmbient;
            // rgb = albedo of the height fog, w = multiple scattering (see FogPhase)
            stage float4 FogApplyAlbedo;
            // rgb = light emitted by the height fog per unit of extinction
            stage float4 FogApplyEmissive;
            // Sky cube map: x = mip level read, y = intensity, z = 1 when there is one; w = share of the sky in the light from around
            // (the rest comes from the ground: FogApplyGround)
            stage float4 FogApplySky;
            stage float4x4 FogApplySkyMatrix;
            // rgb = light the ground reflects up
            stage float4 FogApplyGround;
            // rgb = sun color * albedo, w = anisotropy
            stage float4 FogApplySun;
            // xyz = direction the sun light travels, w = distance used for the sky (0: the sky is not fogged)
            stage float4 FogApplySunDirection;
            stage float3 FogApplyEye;
            // Aerial perspective volume (see AtmosphereCameraVolume): x = kilometers per slice, y = distance scale, z = 1 when there is one
            stage float4 FogApplyAerialPerspective;
        };

        stage SamplerState FogApplySampler
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
            AddressW = Clamp;
        };

        // The sky light reaching the height fog along a view direction (the sky above the horizon)
        stage float3 FogSkyLight(float3 direction)
        {
            if (FogApplySky.z <= 0.0)
                return FogApplyAmbient.rgb;
            direction.y = max(direction.y, 0.05);
            float3 sampleDirection = mul(normalize(direction), (float3x3)FogApplySkyMatrix);
            sampleDirection.z = -sampleDirection.z;
            float3 sky = FogSkyCubeMap.SampleLevel(FogApplySampler, sampleDirection, FogApplySky.x).rgb * FogApplySky.y;
            return lerp(FogApplyGround.rgb, sky, FogApplySky.w);
        }

        // The atmosphere between the camera and a point at a distance (meters) on the screen: rgb = light scattered towards the
        // camera, a = transmittance
        stage float4 EvaluateAerialPerspective(float2 uv, float distance)
        {
            if (FogApplyAerialPerspective.z <= 0.0)
                return float4(0.0, 0.0, 0.0, 1.0);
            float slice = distance * 0.001 * FogApplyAerialPerspective.y / FogApplyAerialPerspective.x;
            // (fades in from the camera over the first half slice)
            float weight = saturate(slice * 2.0);
            float4 aerial = FogAerialPerspective.SampleLevel(FogApplySampler, float3(uv, sqrt(max(slice, 0.5) / 32.0)), 0);
            return float4(aerial.rgb * weight, lerp(1.0, aerial.a, weight));
        }

        // Fog between the camera and a point at a view depth, along ray (camera to point, world space), and the atmosphere's
        // aerial perspective behind it (not for the sky, which holds it already).
        // Returns rgb = light scattered towards the camera, a = transmittance: color = color * a + rgb.
        stage float4 EvaluateFog(float2 uv, float depth, float3 ray, float dither, bool aerialPerspective)
        {
            float4 fog = EvaluateHeightFog(uv, depth, ray, dither);
            if (aerialPerspective)
            {
                float4 aerial = EvaluateAerialPerspective(uv, length(ray));
                fog.rgb += fog.a * aerial.rgb;
                fog.a *= aerial.a;
            }
            return fog;
        }

        // The fog (froxel volume and height fog) between the camera and a point at a view depth, along ray (camera to point)
        stage float4 EvaluateHeightFog(float2 uv, float depth, float3 ray, float dither)
        {
            float4 fog = float4(0.0, 0.0, 0.0, 1.0);
            if (FogApplyAmbient.w <= 0.0)
                return fog;

            float volumeEnd = FogApplyGrid.z;
            float volumeFraction = 0.0;
            if (FogApplyHeight.w > 0.0)
            {
                // Texel z holds the fog up to the far end of slice z
                float slice = FogDepthToSlice(min(depth, volumeEnd), FogApplyGrid) * FogApplyGrid.w;
                float w = (slice - 0.5 + (dither - 0.5) * 0.75) / FogApplyGrid.w;
                fog = FogIntegrated.SampleLevel(FogApplySampler, float3(uv, saturate(w)), 0);
                // Close to the camera, ramp in from no fog
                fog = lerp(float4(0.0, 0.0, 0.0, 1.0), fog, saturate(slice));
                volumeFraction = min(1.0, volumeEnd / max(depth, 1e-4));
            }

            // Height fog beyond the volume
            if (volumeFraction < 1.0 && FogApplyHeight.x > 0.0)
            {
                float3 start = FogApplyEye + ray * volumeFraction;
                float3 segment = ray * (1.0 - volumeFraction);
                float opticalDepth = FogHeightOpticalDepth(start, segment, FogApplyHeight.x, FogApplyHeight.y, FogApplyHeight.z);
                float transmittance = exp(-opticalDepth);
                float3 toEye = -normalize(ray);
                float3 light = FogSkyLight(ray) * FogApplyAlbedo.rgb + FogApplyEmissive.rgb + FogApplySun.rgb * FogPhase(dot(FogApplySunDirection.xyz, toEye), FogApplySun.w, FogApplyAlbedo.w);
                fog.rgb += fog.a * light * (1.0 - transmittance);
                fog.a *= transmittance;
            }
            return fog;
        }
    };
}

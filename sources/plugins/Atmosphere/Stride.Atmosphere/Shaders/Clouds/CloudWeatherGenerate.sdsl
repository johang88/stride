namespace Stride.Atmosphere
{
    /// <summary>
    /// Generates the weather map (a world tile): x = coverage field of the low layer (clusters of cells, values spread
    /// evenly over 0-1 so a coverage maps to the share of the sky it fills), y = cloud type variation (per cell, within
    /// regions), z = field of the
    /// middle layer, w = field of the high layer. The fields evolve through a periodic third dimension: clouds form and
    /// dissipate.
    /// </summary>
    shader CloudWeatherGenerate : ComputeShaderBase, AtmosphereNoise
    {
        stage RWTexture2D<float4> CloudWeatherOutput;

        cbuffer PerDispatch
        {
            stage int CloudWeatherSize;
            // Phase of the evolution (0-1, periodic)
            stage float CloudWeatherEvolution;
            stage uint CloudWeatherSeed;
            // Average size of the low cloud cells relative to the tile (cells per tile)
            stage float CloudWeatherCells;
        };

        // A normally distributed field (mean 0.5) spread evenly over 0-1
        float Equalize(float value, float sigma)
        {
            return 1.0 / (1.0 + exp(-1.702 * (value - 0.5) / sigma));
        }

        override void Compute()
        {
            int2 texel = (int2)streams.DispatchThreadId.xy;
            if (any(texel >= CloudWeatherSize))
                return;
            float2 uv = (texel + 0.5) / CloudWeatherSize;
            uint seed = CloudWeatherSeed * 131u;

            // Domain warp: bent, irregular clusters instead of round blobs
            float3 warpUvw = float3(uv, CloudWeatherEvolution);
            float2 warp = float2(GradientFbm(warpUvw, 3, 3, seed + 1u), GradientFbm(warpUvw + 0.37, 3, 3, seed + 2u)) - 0.5;
            float3 uvw = float3(frac(uv + warp * 0.08), CloudWeatherEvolution);

            // Low layer: broad clusters (gradient octaves) holding cells (Worley), each cell a cloud
            int cells = max(2, (int)CloudWeatherCells);
            float clusters = GradientFbm(uvw, 3, 5, seed + 3u);
            float cellValue;
            float cellNoise = 1.0 - WorleyNoiseCell(uvw * cells, int3(cells, cells, 1), seed + 4u, cellValue);
            float smallCells = 1.0 - WorleyNoise(uvw * cells * 2, int3(cells * 2, cells * 2, 1), seed + 5u);
            float low = clusters * 0.55 + (cellNoise * 0.7 + smallCells * 0.3) * 0.45;
            low = Equalize(low, 0.11);

            // Type variation: each cell its own, within regions of taller or flatter clouds
            float type = lerp(GradientFbm(uvw + 0.13, 2, 3, seed + 6u), cellValue, 0.6);

            // Middle layer: wide fields
            float mid = GradientFbm(uvw + float3(0.51, 0.23, 0.0), 3, 4, seed + 7u) * 0.8 + (1.0 - WorleyNoise(uvw * 5, int3(5, 5, 1), seed + 8u)) * 0.2;
            mid = Equalize(mid, 0.075);

            // High layer: long bands
            float high = GradientFbm(uvw + float3(0.77, 0.61, 0.0), 2, 4, seed + 9u);
            high = Equalize(high, 0.08);

            CloudWeatherOutput[texel] = float4(low, type, mid, high);
        }
    };
}

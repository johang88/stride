namespace Stride.Atmosphere
{
    /// <summary>
    /// Top-down map of the transmittance of the light through the clouds around the camera: each texel marches from the
    /// ground at sea level up along the light through the low and middle layers (without the fine detail).
    /// R = the light reaching the ground (the beam and the light the clouds scatter on down), G = the beam (the shafts in
    /// the fog between the clouds).
    /// </summary>
    shader CloudShadowMap : ComputeShaderBase, CloudCommon
    {
        stage RWTexture2D<float2> CloudShadowOutput;

        cbuffer PerDispatch
        {
            // xy = world XZ of the map's corner, z = world size, w = texels along a side
            stage float4 CloudShadowRect;
            stage float3 CloudShadowEye;
        };

        override void Compute()
        {
            int2 texel = (int2)streams.DispatchThreadId.xy;
            if (any(texel >= (int)CloudShadowRect.w))
                return;

            float2 xz = CloudShadowRect.xy + (texel + 0.5) / CloudShadowRect.w * CloudShadowRect.z;
            float3 L = CloudLightDirection;
            if (L.y < 0.01)
            {
                CloudShadowOutput[texel] = float2(1.0, 1.0);
                return;
            }

            float3 ground = float3(xz.x, AtmosphereSeaLevel, xz.y);
            float tStart = RayAltitude(ground, L, CloudLowLayer.x - 400.0, true);
            float tEnd = RayAltitude(ground, L, max(CloudLowLayer.x + CloudLowLayer.y, CloudMidLayer.x + CloudMidLayer.y), true);
            const float steps = 24.0;
            float dt = (tEnd - tStart) / steps;
            float opticalDepth = 0.0;
            for (float i = 0.0; i < steps; i += 1.0)
            {
                float3 position = ground + L * (tStart + (i + 0.5) * dt);
                float altitude = CloudAltitude(position);
                float heightFraction;
                float profile;
                float density = LowDensity(position, altitude, 150.0, false, heightFraction, profile) * CloudLowShape.x;
                density += MidDensity(position, altitude, 150.0, false, heightFraction, profile) * CloudMidShape.x;
                opticalDepth += density * dt;
            }
            float beam = exp(-opticalDepth);
            // Clouds scatter the light they stop rather than absorb it: much of it still reaches the ground below them, from
            // the bright cloud base (a share that only the deepest storm clouds swallow)
            float reaching = beam + (1.0 - beam) * 0.45 * exp(-opticalDepth * 0.05);
            // (in the fog: the beam, with a little multiple scattering, so the shafts between the clouds stand out)
            float shafts = max(beam, 0.18 * exp(-opticalDepth * 0.08));
            CloudShadowOutput[texel] = float2(reaching, shafts);
        }
    };
}

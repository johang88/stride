namespace Stride.Atmosphere
{
    /// <summary>
    /// Generates the tiling noise volumes of the clouds. Shape (mode 0): r = Perlin-Worley (gradient noise octaves remapped
    /// by billowy Worley octaves: wispy, connected), gba = billowy Worley octaves of 4, 8 and 16 cells per tile. Detail
    /// (mode 1): rgb = billowy Worley octaves of 2, 4 and 8 cells, a = gradient noise.
    /// </summary>
    shader CloudNoiseGenerate : ComputeShaderBase, AtmosphereNoise
    {
        stage RWTexture3D<float4> CloudNoiseOutput;

        cbuffer PerDispatch
        {
            stage int CloudNoiseSize;
            stage int CloudNoiseMode;
        };

        override void Compute()
        {
            int3 texel = (int3)streams.DispatchThreadId;
            if (any(texel >= CloudNoiseSize))
                return;
            float3 uvw = (texel + 0.5) / CloudNoiseSize;

            if (CloudNoiseMode == 0)
            {
                float perlin = GradientFbm(uvw, 4, 6, 3u);
                float worley4 = WorleyFbm(uvw, 4, 11u);
                float worley8 = WorleyFbm(uvw, 8, 23u);
                float worley16 = WorleyFbm(uvw, 16, 37u);
                // Perlin-Worley: the gradient noise remapped onto the Worley cells
                float perlinWorley = saturate(Remap(perlin, worley4 - 1.0, 1.0, 0.0, 1.0));
                CloudNoiseOutput[texel] = float4(perlinWorley, worley4, worley8, worley16);
            }
            else
            {
                CloudNoiseOutput[texel] = float4(WorleyFbm(uvw, 2, 51u), WorleyFbm(uvw, 4, 63u), WorleyFbm(uvw, 8, 77u), GradientFbm(uvw, 4, 4, 91u));
            }
        }
    };
}

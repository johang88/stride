namespace Stride.Atmosphere
{
    /// <summary>
    /// Full-screen pass drawing the sky and the media over the opaque surfaces.
    /// </summary>
    effect AtmosphereCompositeEffect
    {
        mixin AtmosphereComposite;
    };
}

namespace Stride.Rendering.Lights
{
    /// <summary>
    /// Defines a skybox environment light
    /// </summary>
    shader LightSkyboxShader : EnvironmentLight, MaterialPixelShadingStream, NormalStream, Transformation
    {
        cbuffer PerView.Lighting
        {
            float4x4 SkyMatrix;
            float Intensity;
        }

        compose IComputeEnvironmentColor lightDiffuseColor;

        compose IComputeEnvironmentColor lightSpecularColor;

        override void PrepareEnvironmentLight()
        {
            base.PrepareEnvironmentLight();

            var ambientAccessibility = streams.matAmbientOcclusion;

            // -----------------------------------------
            // Diffuse lighting
            // -----------------------------------------
            // TODO: This could be optimized by having a flag to allow rotation only if necessary
            // Rotate the skybox
            var sampleDirection = mul(streams.normalWS, (float3x3)SkyMatrix);
            sampleDirection = float3(sampleDirection.xy, -sampleDirection.z);

            streams.envLightDiffuseColor = lightDiffuseColor.Compute(sampleDirection).rgb * Intensity * ambientAccessibility * streams.matDiffuseSpecularAlphaBlend.x;

            if (streams.subsurfaceLightingAmount > 0.0)
            {
                // Translucency is light reaching the surface through its back, so only the
                // opposite hemisphere contributes. The previous version also added
                // envLightDiffuseColor * 0.5 back in, which double counted the front hemisphere
                // just accumulated above - on its own that inflated ambient by 1.5x at an amount
                // of 1, before the back side was even considered.
                float3 backLight = lightDiffuseColor.Compute(-sampleDirection).rgb * Intensity * ambientAccessibility * streams.matDiffuseSpecularAlphaBlend.x;

                // How much light actually gets through the surface is folded into
                // subsurfaceLightingAmount by the shading model rather than carried as a separate
                // per-channel stream. Adding a stream here changes the stream layout of every
                // lit shader, which perturbs SPIR-V type emission order and trips a backend bug
                // when atmosphere functions take Texture2D parameters - not worth a colour tint.
                streams.envLightDiffuseColor += backLight * streams.subsurfaceLightingAmount;
            }

            // -----------------------------------------
            // Specular lighting
            // -----------------------------------------
            // TODO: This could be optimized by having a flag to allow rotation only if necessary
            // Rotate the skybox
            // TODO: Sample into "Importance Sampling" direction instead of the "reflect" direction
            sampleDirection = reflect( -streams.viewWS, streams.normalWS );
            sampleDirection = mul(sampleDirection, (float3x3)SkyMatrix);
            sampleDirection = float3(sampleDirection.xy, -sampleDirection.z);

            streams.envLightSpecularColor = lightSpecularColor.Compute(sampleDirection).rgb * Intensity * ambientAccessibility * streams.matDiffuseSpecularAlphaBlend.y;
        }
    };
}

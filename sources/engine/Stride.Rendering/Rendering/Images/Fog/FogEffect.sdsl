namespace Stride.Rendering.Images
{
    /// <summary>
    /// Simple fog
    /// </summary>
    internal shader FogEffect : ImageEffectShader
    {
        stage float FogStart = 0.0f;
        stage float Density = 1.0f;
        stage float zFar = 1000.0f;
        stage float zNear = 0.1f;
        stage bool skipBG = false;

        [Color]
        stage float3 FogColor = float3(1.0, 1.0, 1.0);
        stage Texture2D DepthTexture;

        // Depths are reversed: the near plane sits at 1 and the far plane (the background) at 0
        float LinearDepth(float depth)
        {
            return zNear * zFar / (depth * (zFar - zNear) + zNear);
        }

        stage override float4 Shading()
        {
            float4 color = Texture0.Sample(PointSampler, streams.TexCoord);
            float z_b = DepthTexture.SampleLevel(PointSampler, streams.TexCoord, 0.0).x;

            if (!skipBG || z_b > 0.0) {
                float dist = LinearDepth(z_b);
                dist -= FogStart;

                float fogAmount = clamp(exp(dist * -Density), 0.0, 1.0);

                color.xyz = lerp(FogColor, color.xyz, fogAmount);
            }

            return color;
        }
    };
}

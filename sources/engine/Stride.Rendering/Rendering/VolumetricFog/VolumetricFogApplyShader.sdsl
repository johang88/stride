namespace Stride.Rendering.VolumetricFog
{
    /// <summary>
    /// Fogs the opaque surfaces (and the sky) of a view from its depth buffer (Texture0). Drawn with a blend of
    /// (One, SourceAlpha): the output color is the scattered light, its alpha the transmittance.
    /// </summary>
    shader VolumetricFogApplyShader : ImageEffectShader, VolumetricFogApplyBase
    {
        cbuffer PerDraw
        {
            // 1 / M11, 1 / M22, M31, M32 of the projection
            stage float4 FogApplyProjection;
            // M33, M43 of the (reversed depth) projection: view depth = M43 / (depth + M33)
            stage float2 FogApplyDepth;
            stage float4x4 FogApplyViewInverse;
            stage float2 FogApplyTargetSize;
        };

        stage override float4 Shading()
        {
            float2 uv = streams.TexCoord;
            float zBuffer = Texture0.SampleLevel(PointSampler, uv, 0).r;

            float depth;
            if (zBuffer <= 0.0)
            {
                // The sky (reversed depth: the far plane is at 0)
                if (FogApplySunDirection.w <= 0.0)
                    return float4(0.0, 0.0, 0.0, 1.0);
                depth = FogApplySunDirection.w;
            }
            else
            {
                depth = FogApplyDepth.y / (zBuffer + FogApplyDepth.x);
            }

            float2 ndc = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
            float3 rayVS = float3((ndc + FogApplyProjection.zw) * FogApplyProjection.xy, -1.0) * depth;
            float3 ray = mul(rayVS, (float3x3)FogApplyViewInverse);

            return EvaluateFog(uv, depth, ray, FogDither(uv * FogApplyTargetSize));
        }
    };
}

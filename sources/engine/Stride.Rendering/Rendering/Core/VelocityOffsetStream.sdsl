// Where a vertex animated in the vertex shader (wind, waves) was in the previous frame, relative to where it is now (world
// space): the velocity pass moves the previous position by it, so motion vectors follow the animation. Zero when unset.
shader VelocityOffsetStream
{
    stage stream float3 PreviousPositionOffsetWS;
};

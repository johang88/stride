namespace Stride.Terrain
{
    /// <summary>
    /// Generates the terrain shadows for one light direction: each thread walks one line of shadow texels along the light
    /// (Bresenham), carrying the height of the highest ray blocked so far (dropping by HeightDelta per step) and the distance
    /// to its occluder. Each texel gets (x) that height, normalized like the heightmap, and (y) the occluder distance,
    /// normalized to TerrainShadowMaxDistance: a point is lit above that height (see TerrainShadowMapReceiverDirectional).
    /// Texel centers map linearly onto the terrain: local XZ = (texel + 0.5) / size * terrain size.
    /// </summary>
    shader TerrainShadowGenerator : ComputeShaderBase
    {
        stage RWTexture2D<float2> TerrainShadowOutput;

        // R16_UNorm heights, one texel per sample, with mip maps
        stage Texture2D<float> TerrainShadowHeightmap;

        // Line starts: xy, or zw for the threads past the first 4096
        cbuffer TerrainShadowStarts
        {
            stage int4 TerrainShadowStartXY[4096];
        };

        struct TerrainShadowGroupData
        {
            int Iterations;
            float DeltaErrorStart;
            float Padding0;
            float Padding1;
        };

        cbuffer TerrainShadowGroups
        {
            stage TerrainShadowGroupData TerrainShadowGroup[4096];
        };

        cbuffer PerDispatch
        {
            // Bresenham deltas and steps
            stage float2 TerrainShadowDelta;
            stage float2 TerrainShadowXyStep;
            stage int TerrainShadowIsSteep;
            // Height (meters) the light ray drops per step along the major axis, and the length of that step (meters)
            stage float TerrainShadowHeightDelta;
            stage float TerrainShadowStepLength;
            // Shadow texel size (meters), heightmap mip read and its sample spacing (meters), samples per side of that mip
            stage float TerrainShadowTexelSize;
            stage int TerrainShadowHeightMip;
            stage float TerrainShadowHeightSpacing;
            stage int TerrainShadowHeightSamples;
            // Heights: min (meters) and range, occluder distance normalization
            stage float TerrainShadowMinHeight;
            stage float TerrainShadowHeightRange;
            stage float TerrainShadowMaxDistance;
        };

        float LoadTerrainHeight(int2 texel)
        {
            float2 localXZ = (texel + 0.5) * TerrainShadowTexelSize;
            int2 samplePos = clamp((int2)round(localXZ / TerrainShadowHeightSpacing), 0, TerrainShadowHeightSamples - 1);
            return TerrainShadowMinHeight + TerrainShadowHeightmap.Load(int3(samplePos, TerrainShadowHeightMip)) * TerrainShadowHeightRange;
        }

        // state: x = height of the highest blocked ray at the previous texel, y = distance to its occluder
        float2 Step(int2 texel, float2 state)
        {
            state.x -= TerrainShadowHeightDelta;
            state.y += TerrainShadowStepLength;

            // Lit above the rays blocked by the texels before this one
            float lit = saturate((state.x - TerrainShadowMinHeight) / max(TerrainShadowHeightRange, 1e-4));
            TerrainShadowOutput[texel] = float2(lit, saturate(state.y / TerrainShadowMaxDistance));

            float height = LoadTerrainHeight(texel);
            if (height >= state.x)
                state = float2(height, 0.0);
            return state;
        }

        override void Compute()
        {
            float2 state = float2(-1e30, 0.0);
            float error = TerrainShadowDelta.x * 0.5 + TerrainShadowGroup[streams.GroupId.x].DeltaErrorStart;

            int x, y;
            if (streams.DispatchThreadId.x < 4096u)
            {
                x = TerrainShadowStartXY[streams.DispatchThreadId.x].x;
                y = TerrainShadowStartXY[streams.DispatchThreadId.x].y;
            }
            else
            {
                x = TerrainShadowStartXY[streams.DispatchThreadId.x - 4096u].z;
                y = TerrainShadowStartXY[streams.DispatchThreadId.x - 4096u].w;
            }

            int iterations = TerrainShadowGroup[streams.GroupId.x].Iterations;
            for (int i = 0; i < iterations; ++i)
            {
                if (TerrainShadowIsSteep)
                    state = Step(int2(y, x), state);
                else
                    state = Step(int2(x, y), state);

                error -= TerrainShadowDelta.y;
                if (error < 0)
                {
                    y += (int)TerrainShadowXyStep.y;
                    error += TerrainShadowDelta.x;
                }
                x += (int)TerrainShadowXyStep.x;
            }
        }
    };
}

namespace Stride.Terrain
{
    /// <summary>
    /// Directional light shadows combined with the baked terrain shadows (see TerrainShadowManager), which reach beyond
    /// the shadow map cascades.
    /// </summary>
    shader TerrainShadowMapReceiverDirectional<int TCascadeCount,
                                               int TLightCount,
                                               bool TBlendCascades,
                                               bool TDepthRangeAuto,
                                               bool TCascadeDebug,
                                               bool TComputeTransmittance> :
        ShadowMapReceiverDirectional<TCascadeCount, TLightCount, TBlendCascades, TDepthRangeAuto, TCascadeDebug, TComputeTransmittance>
    {
        rgroup PerView.Lighting
        {
            Texture2D TerrainShadowTexture;
        }

        cbuffer PerView.Lighting
        {
            // xy = world XZ of the terrain origin, z = 1 / terrain size, w = 1 when the terrain shadows are ready
            float4 TerrainShadowRegion;
            // x = min height, y = height range, z = maximum occluder distance, w = penumbra width per meter of occluder distance
            float4 TerrainShadowParams;
            // x = height bias, y = minimum penumbra width
            float2 TerrainShadowBias;
        }

        stage SamplerState TerrainShadowSampler
        {
            Filter = MIN_MAG_MIP_LINEAR;
            AddressU = Clamp;
            AddressV = Clamp;
        };

        override float3 ComputeShadow(float3 position, int lightIndex)
        {
            float3 shadow = base.ComputeShadow(position, lightIndex);
            if (TerrainShadowRegion.w <= 0.0)
                return shadow;

            float2 uv = (position.xz - TerrainShadowRegion.xy) * TerrainShadowRegion.z;
            if (any(uv < 0.0) || any(uv > 1.0))
                return shadow;

            float2 baked = TerrainShadowTexture.SampleLevel(TerrainShadowSampler, uv, 0).xy;
            float litHeight = TerrainShadowParams.x + baked.x * TerrainShadowParams.y;
            float width = max(TerrainShadowBias.y, baked.y * TerrainShadowParams.z * TerrainShadowParams.w);
            float terrainShadow = smoothstep(-0.5 * width, 0.5 * width, position.y + TerrainShadowBias.x - litHeight);

            // Both see the terrain up close: keep the darker one instead of darkening twice
            return min(shadow, terrainShadow);
        }
    };
}

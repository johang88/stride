namespace Stride.Terrain
{
    /// <summary>
    /// Sways plants in the wind: world space offset growing with the height above the model origin, travelling as a wave
    /// along the wind direction, with a little variation per vertex.
    /// </summary>
    shader MaterialTerrainGrassWind<float WindStrength, float WindSpeed> : IMaterialSurface, PositionStream4, TransformationBase, Global
    {
        override void Compute()
        {
        }

        stage override void TransformPosition()
        {
            base.TransformPosition();

            float2 windDirection = float2(0.957826, 0.287348);
            float phase = dot(streams.PositionWS.xz, windDirection) * 0.5 + Time * WindSpeed;
            float sway = sin(phase) * WindStrength + sin(phase * 2.37 + 1.3) * WindStrength * 0.3;
            float flutter = sin(streams.Position.x * 3.7 + streams.Position.z * 2.1 + Time * WindSpeed * 2.3) * WindStrength * 0.25;

            float height = max(streams.Position.y, 0.0);
            streams.PositionWS.xz += (windDirection * sway + float2(flutter, flutter * 0.5)) * height;
        }
    };
}

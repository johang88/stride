namespace Stride.Terrain
{
    /// <summary>
    /// Foliage shading, added to the material's diffuse model: thin leaves and blades are lit through both faces. The lit side
    /// gets wrapped diffuse light; light from behind goes through the leaf, tinted by the transmission color, strongest when
    /// looking towards the light (the glow of backlit grass). The ambient back light is added by the skybox light from
    /// subsurfaceLightingAmount. Two sided: the side facing the viewer is the one lit.
    /// </summary>
    shader MaterialTerrainVegetationSubsurfaceShading : IMaterialSurfaceShading, Math, ShaderBaseStream, ShadowStream, NormalStream
    {
        compose ComputeColor SubsurfaceLightingAmount;
        compose ComputeColor Extinction;

        // The color of the light going through a leaf
        stream float3 extinction;

        // How far the diffuse light wraps around the lit side (0: Lambert)
        stream float subsurfaceWrap;

        override void PrepareForLightingAndShading()
        {
            base.PrepareForLightingAndShading();

            // The Extinction map is a transmission color (e.g. a dark green: daylight after going through a leaf)
            streams.extinction = Extinction.Compute().xyz;
            float authoredAmount = saturate(SubsurfaceLightingAmount.Compute().x);
            streams.subsurfaceWrap = authoredAmount * 0.6;

            // How much sky light from behind gets through, for LightSkyboxShader (luminance: a per channel tint would need a
            // new light stream)
            float transmittance = dot(streams.extinction, float3(0.2126, 0.7152, 0.0722));
            streams.subsurfaceLightingAmount = authoredAmount * transmittance;

            // Leaves and blades are a mess of small, differently oriented surfaces: their highlight is broad and dim, not the
            // white glints of a smooth surface (seen towards the sun, on back faces especially)
            streams.alphaRoughness = max(streams.alphaRoughness, 0.3);
            streams.matDiffuseSpecularAlphaBlend.y *= 0.5;
        }

        override float3 ComputeDirectLightContribution()
        {
            // lightColor is the raw light: the shadows and attenuation are folded in here (NdotL is not, light reaches a leaf
            // through both faces)
            float3 light = streams.lightColor * streams.lightAttenuation * streams.shadowColor * streams.lightDirectAmbientOcclusion;
            float3 albedo = streams.matDiffuseVisible;
            // Cards and blades are seen from both sides: the side facing the viewer is the one lit by wrapped light. The diffuse
            // model (Lambert) and the specular keep the mesh normal (no highlights on back faces)
            float meshNDotL = dot(streams.normalWS, streams.lightDirectionWS);
            float nDotL = dot(streams.normalWS, streams.viewWS) < 0.0 ? -meshNDotL : meshNDotL;

            // Replaces the diffuse model's light by wrapped light on the side facing the viewer
            float wrap = streams.subsurfaceWrap;
            float wrapped = saturate((nDotL + wrap) / (1.0 + wrap)) / (1.0 + wrap * 0.5);
            float3 front = albedo * (wrapped - saturate(meshNDotL));

            // Through the leaf: from behind, and much more when the light is right behind it as seen from the viewer
            float back = saturate(-nDotL);
            float forward = pow(saturate(dot(-streams.viewWS, streams.lightDirectionWS)), 6.0);
            // Green living leaves let light through, dry brown ones barely
            float leafiness = saturate((albedo.g - albedo.r) * 6.0 + 0.6);
            float3 transmitted = streams.extinction * sqrt(max(albedo, 0.0)) * lerp(0.15, 1.0, leafiness) * (back * 0.9 + forward * 2.2);

            return (front + transmitted) / PI * light * streams.matDiffuseSpecularAlphaBlend.x;
        }

        override float3 ComputeEnvironmentLightContribution()
        {
            // The diffuse model adds the ambient light, which includes the back light (LightSkyboxShader)
            return float3(0, 0, 0);
        }
    };
}

namespace Stride.Terrain
{
    /// <summary>
    /// Material pixel stage of the terrain using the runtime virtual texture (falls back to blending the layers when it isn't active).
    /// </summary>
    shader TerrainMaterialSurfaceVirtualTexture : IMaterialSurfacePixel, TerrainLayers, TerrainBrushOverlay, TerrainVirtualTextureBase, NormalStream, PositionStream4
    {
        cbuffer PerMaterial
        {
            // 1 when the active virtual texture is this terrain's
            stage float TerrainVTIsOwn;
        }

        override void Compute()
        {
            float2 localXZ = streams.TerrainLocalXZ;
            float2 dx = ddx(localXZ);
            float2 dy = ddy(localXZ);
            float3 macroNormal = TerrainSampleNormal(localXZ, dx, dy);

            float3 albedo;
            float3 normalTS;
            float roughness;
            float occlusion;
            if (TerrainVTIsActive() && TerrainVTIsOwn > 0.5)
            {
                float2 vuv = TerrainVTWorldToUV(streams.PositionWS.xyz);
                TerrainVTSurface surface = TerrainVTSample(vuv, ddx(vuv), ddy(vuv));
                albedo = surface.Albedo;
                normalTS = surface.NormalTS;
                roughness = surface.Roughness;
                occlusion = surface.Occlusion;
            }
            else
            {
                TerrainSurface surface = TerrainSampleLayers(localXZ, dx, dy);
                albedo = surface.Albedo;
                normalTS = surface.NormalTS;
                roughness = surface.Roughness;
                occlusion = surface.Occlusion;
            }

            streams.normalWS = TerrainTangentToLocal(normalTS, macroNormal);
            streams.matDiffuse = float4(TerrainApplyBrush(albedo, localXZ, dx, dy), 1.0);
            streams.matColorBase = streams.matDiffuse;
            streams.matGlossiness = clamp(1.0 - roughness, 0.0, 0.9);
            streams.matAmbientOcclusion = occlusion;
        }
    };
}

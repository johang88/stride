namespace Stride.Terrain
{
    /// <summary>
    /// Albedo of the terrain under the object (from the terrain virtual texture).
    /// </summary>
    shader ComputeTerrainBlendColor : ComputeColor, TerrainVirtualTextureBase, PositionStream4
    {
        override float4 Compute()
        {
            float2 vuv = TerrainVTWorldToUV(streams.PositionWS.xyz);
            TerrainVTSurface surface = TerrainVTSample(vuv, ddx(vuv), ddy(vuv));
            return float4(surface.Albedo, 1);
        }
    };
}

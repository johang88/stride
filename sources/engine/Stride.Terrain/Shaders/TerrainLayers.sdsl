namespace Stride.Terrain
{
    /// <summary>
    /// Decodes the terrain splat map and blends the material layers (height-based blending).
    /// The splat layout must match TerrainSplat.cs.
    /// </summary>
    shader TerrainLayers : TerrainBase
    {
        struct TerrainSurface
        {
            float3 Albedo;
            // Tangent space normal: X along +X local, Y along +Z local, Z up
            float3 NormalTS;
            float Roughness;
            float Occlusion;
            // Blended height map value (0-1), used for parallax occlusion mapping
            float Height;
        };

        rgroup PerMaterial
        {
            // Albedo (sRGB) + height
            stage Texture2DArray TerrainAlbedoHeightArray;
            // Normal XY + roughness + occlusion
            stage Texture2DArray TerrainNormalRoughnessArray;
        }

        cbuffer PerMaterial
        {
            // x = 1 / tile size, y = normal strength, z = height blend scale, w = height blend offset
            stage float4 TerrainLayerParams[64];
            // rgb = albedo tint, a = roughness scale
            stage float4 TerrainLayerTints[64];
            // x = tiling variation amount, y = tri-planar projection (1) or top-down (0)
            stage float4 TerrainLayerVariations[64];
            stage float TerrainHeightBlendSharpness;
            // x = cliff layer (negative: none), y = slope where it starts, z = slope where it fully covers (slope = 1 - normal.y),
            // w = 1 when the material has tri-planar layers or a cliff layer (steep slopes bypass the virtual texture)
            stage float4 TerrainCliffParams;
            // x = parallax depth (meters, 0: off), y = distance over which it fades out (meters)
            stage float4 TerrainParallax;
        }

        stage SamplerState TerrainLayerSampler
        {
            Filter = ANISOTROPIC;
            MaxAnisotropy = 8;
            AddressU = Wrap;
            AddressV = Wrap;
        };


        // Value noise (0-1) used to break the splat grid
        float TerrainHash(float2 p)
        {
            p = frac(p * float2(0.1031, 0.1030));
            p += dot(p, p.yx + 33.33);
            return frac((p.x + p.y) * p.x);
        }

        float TerrainValueNoise(float2 p)
        {
            float2 i = floor(p);
            float2 f = frac(p);
            float2 u = f * f * (3.0 - 2.0 * f);
            return lerp(lerp(TerrainHash(i), TerrainHash(i + float2(1, 0)), u.x), lerp(TerrainHash(i + float2(0, 1)), TerrainHash(i + float2(1, 1)), u.x), u.y);
        }

        // Mix factor of the variation sample of a layer: always partly present (no visible period), varying in patches of a few meters
        float TerrainVariationMix(uint layer, float2 localXZ)
        {
            float n = TerrainValueNoise(localXZ * 0.11 + (float)layer * 7.13) * 0.65 + TerrainValueNoise(localXZ * 0.37 + (float)layer * 3.71) * 0.35;
            return TerrainLayerVariations[layer].x * lerp(0.35, 1.0, smoothstep(0.3, 0.7, n));
        }

        // Variation sample coordinates: rotated by about 37 degrees and scaled by 0.61 (matches TerrainVariationNormal)
        float2 TerrainVariationUV(float2 uv)
        {
            return float2(uv.x * 0.8 - uv.y * 0.6, uv.x * 0.6 + uv.y * 0.8) * 0.61 + float2(0.37, 0.71);
        }

        float2 TerrainVariationGradient(float2 d)
        {
            return float2(d.x * 0.8 - d.y * 0.6, d.x * 0.6 + d.y * 0.8) * 0.61;
        }

        // Rotates a variation sample normal (xy) back to the layer tangent space
        float2 TerrainVariationNormal(float2 n)
        {
            return float2(n.x * 0.8 + n.y * 0.6, -n.x * 0.6 + n.y * 0.8);
        }

        float4 TerrainSampleAlbedoHeight(uint layer, float2 uv, float2 dUvDx, float2 dUvDy, float amount)
        {
            float4 value = TerrainAlbedoHeightArray.SampleGrad(TerrainLayerSampler, float3(uv, (float)layer), dUvDx, dUvDy);
            if (amount > 0.001)
            {
                float4 variation = TerrainAlbedoHeightArray.SampleGrad(TerrainLayerSampler, float3(TerrainVariationUV(uv), (float)layer), TerrainVariationGradient(dUvDx), TerrainVariationGradient(dUvDy));
                value = lerp(value, variation, amount);
            }
            return value;
        }

        float4 TerrainSampleNormalRoughness(uint layer, float2 uv, float2 dUvDx, float2 dUvDy, float amount)
        {
            float4 value = TerrainNormalRoughnessArray.SampleGrad(TerrainLayerSampler, float3(uv, (float)layer), dUvDx, dUvDy);
            value.xy = value.xy * 2.0 - 1.0;
            if (amount > 0.001)
            {
                float4 variation = TerrainNormalRoughnessArray.SampleGrad(TerrainLayerSampler, float3(TerrainVariationUV(uv), (float)layer), TerrainVariationGradient(dUvDx), TerrainVariationGradient(dUvDy));
                variation.xy = TerrainVariationNormal(variation.xy * 2.0 - 1.0);
                value = lerp(value, variation, amount);
            }
            return value;
        }

        void TerrainAddLayer(uint layer, float weight, inout uint layers[12], inout float weights[12], inout int count)
        {
            if (weight > 0.0 && layer != 63)
            {
                bool found = false;
                for (int i = 0; i < count; i++)
                {
                    if (layers[i] == layer)
                    {
                        weights[i] += weight;
                        found = true;
                    }
                }
                if (!found)
                {
                    layers[count] = layer;
                    weights[count] = weight;
                    count++;
                }
            }
        }

        void TerrainAddSplat(uint value, float scale, inout uint layers[12], inout float weights[12], inout int count)
        {
            float weightA = (float)((value >> 18) & 127);
            float weightB = (float)((value >> 25) & 127);
            float weightC = max(0.0, 127.0 - weightA - weightB);
            float s = scale / 127.0;
            TerrainAddLayer(value & 63, weightA * s, layers, weights, count);
            TerrainAddLayer((value >> 6) & 63, weightB * s, layers, weights, count);
            TerrainAddLayer((value >> 12) & 63, weightC * s, layers, weights, count);
        }

        // Samples and blends the layers at a local position (height included), around the height field normal (macroNormal).
        // dLocalDx/dLocalDy are the local XZ derivatives used to filter the layer textures.
        TerrainSurface TerrainSampleLayers(float3 localPosition, float3 macroNormal, float2 dLocalDx, float2 dLocalDy)
        {
            float2 localXZ = localPosition.xz;
            float3 triplanarBlend = TerrainTriplanarBlend(macroNormal);
            uint layers[12];
            float weights[12];
            float4 albedoHeight[12];
            float blendHeights[12];
            float variationMix[12];
            for (int k = 0; k < 12; k++)
            {
                variationMix[k] = 0.0;
                layers[k] = 0;
                weights[k] = 0.0;
                albedoHeight[k] = float4(0, 0, 0, 0);
                blendHeights[k] = 0.0;
            }
            int count = 0;

            // Bilinear interpolation of the splat samples (texel centers are on the samples), at a position warped by
            // noise so that layer transitions don't follow the sample grid (stair steps along painted edges)
            float2 warpCoordinates = localXZ / (TerrainCellSize * 3.0);
            float2 warp = float2(TerrainValueNoise(warpCoordinates), TerrainValueNoise(warpCoordinates + float2(37.2, 11.7))) - 0.5;
            warp += (float2(TerrainValueNoise(warpCoordinates * 3.1 + 5.3), TerrainValueNoise(warpCoordinates * 3.1 + float2(71.9, 2.1))) - 0.5) * 0.4;
            float2 t = (localXZ + warp * TerrainCellSize * 1.6) / TerrainCellSize;
            float2 cell = floor(t);
            float2 f = t - cell;
            int2 p = (int2)cell;
            TerrainAddSplat(TerrainLoadSplat(p), (1.0 - f.x) * (1.0 - f.y), layers, weights, count);
            TerrainAddSplat(TerrainLoadSplat(p + int2(1, 0)), f.x * (1.0 - f.y), layers, weights, count);
            TerrainAddSplat(TerrainLoadSplat(p + int2(0, 1)), (1.0 - f.x) * f.y, layers, weights, count);
            TerrainAddSplat(TerrainLoadSplat(p + int2(1, 1)), f.x * f.y, layers, weights, count);

            if (count == 0)
            {
                layers[0] = 0;
                weights[0] = 1.0;
                count = 1;
            }

            // Height-based blending: layers compete with (weight + height), only those close to the highest one remain.
            // A little per-layer noise keeps the borders irregular where layers have flat height maps.
            float maxHeight = -1e9;
            for (int i = 0; i < count; i++)
            {
                float4 layerParams = TerrainLayerParams[layers[i]];
                float2 uv = localXZ * layerParams.x;
                variationMix[i] = TerrainVariationMix(layers[i], localXZ);
                if (TerrainIsTriplanar(layers[i]) && triplanarBlend.y < 0.99)
                {
                    float4 unused;
                    TerrainSampleTriplanar(layers[i], localPosition, macroNormal, triplanarBlend, dLocalDx, dLocalDy, albedoHeight[i], unused);
                }
                else
                {
                    albedoHeight[i] = TerrainSampleAlbedoHeight(layers[i], uv, dLocalDx * layerParams.x, dLocalDy * layerParams.x, variationMix[i]);
                }
                float layerNoise = TerrainValueNoise(localXZ * 1.7 + (float)layers[i] * 17.31) - 0.5;
                // The height map only competes where the layer is actually painted: a nearly absent layer with a strong
                // height map would otherwise win right up to the line where its weight reaches zero (hard edges)
                float presence = saturate(weights[i] * 3.0);
                blendHeights[i] = weights[i] + (albedoHeight[i].a * layerParams.z + layerParams.w + layerNoise * 0.25) * presence;
                maxHeight = max(maxHeight, blendHeights[i]);
            }

            float threshold = maxHeight - TerrainHeightBlendSharpness;
            float3 albedo = 0;
            float4 normalRoughness = 0;
            float height = 0;
            float totalWeight = 0;
            for (int j = 0; j < count; j++)
            {
                float w = max(blendHeights[j] - threshold, 0.0);
                if (w > 0.0)
                {
                    float4 layerParams = TerrainLayerParams[layers[j]];
                    float4 tint = TerrainLayerTints[layers[j]];
                    float2 uv = localXZ * layerParams.x;
                    float4 nr;
                    if (TerrainIsTriplanar(layers[j]) && triplanarBlend.y < 0.99)
                    {
                        float4 unused;
                        TerrainSampleTriplanar(layers[j], localPosition, macroNormal, triplanarBlend, dLocalDx, dLocalDy, unused, nr);
                    }
                    else
                    {
                        nr = TerrainSampleNormalRoughness(layers[j], uv, dLocalDx * layerParams.x, dLocalDy * layerParams.x, variationMix[j]);
                        nr.xy *= layerParams.y;
                    }
                    nr.z *= tint.a;
                    albedo += albedoHeight[j].rgb * tint.rgb * w;
                    normalRoughness += nr * w;
                    height += albedoHeight[j].a * w;
                    totalWeight += w;
                }
            }

            float invTotal = 1.0 / max(totalWeight, 1e-5);
            // Large scale brightness variation (breaks the uniformity of big areas of the same layer)
            float macro = TerrainValueNoise(localXZ * 0.031) * 0.6 + TerrainValueNoise(localXZ * 0.093 + 13.7) * 0.4;
            TerrainSurface surface;
            surface.Albedo = albedo * invTotal * lerp(0.86, 1.12, macro);
            normalRoughness *= invTotal;
            float2 nxy = normalRoughness.xy;
            surface.NormalTS = float3(nxy, sqrt(saturate(1.0 - dot(nxy, nxy))));
            surface.Roughness = saturate(normalRoughness.z);
            surface.Occlusion = saturate(normalRoughness.w);
            surface.Height = saturate(height * invTotal);
            return surface;
        }

        // Samples a layer with a planar projection (uv and its screen derivatives in meters) and returns albedo (rgb) + height (a)
        // and the tangent space normal (xy) + roughness + occlusion
        void TerrainSampleProjected(uint layer, float2 uvMeters, float2 dUvDx, float2 dUvDy, out float4 albedoHeight, out float4 normalRoughness)
        {
            float4 layerParams = TerrainLayerParams[layer];
            float2 uv = uvMeters * layerParams.x;
            float amount = TerrainVariationMix(layer, uvMeters);
            albedoHeight = TerrainSampleAlbedoHeight(layer, uv, dUvDx * layerParams.x, dUvDy * layerParams.x, amount);
            normalRoughness = TerrainSampleNormalRoughness(layer, uv, dUvDx * layerParams.x, dUvDy * layerParams.x, amount);
            normalRoughness.xy *= layerParams.y;
        }

        // Weights of the three tri-planar projections (x: plane facing X, y: top, z: plane facing Z) for a surface normal
        float3 TerrainTriplanarBlend(float3 macroNormal)
        {
            float3 blend = pow(abs(macroNormal), 4.0);
            return blend / max(blend.x + blend.y + blend.z, 1e-5);
        }

        bool TerrainIsTriplanar(uint layer)
        {
            return TerrainLayerVariations[layer].y > 0.5;
        }

        // Samples a layer projected along the three axes and blended by the slope, so it doesn't stretch on steep terrain.
        // The top projection matches the regular top-down mapping, so flat ground looks the same either way.
        // Returns albedo + height and the tangent space normal (xy, in the frame of the macro normal) + roughness + occlusion.
        void TerrainSampleTriplanar(uint layer, float3 localPosition, float3 macroNormal, float3 blend, float2 dLocalDx, float2 dLocalDy, out float4 albedoHeight, out float4 normalRoughness)
        {
            // Position derivatives on the surface: the height follows the slope (works for virtual texture pages too, which
            // have no screen derivatives of the height)
            float2 slope = -macroNormal.xz / max(macroNormal.y, 0.05);
            float3 dPositionDx = float3(dLocalDx.x, dot(slope, dLocalDx), dLocalDx.y);
            float3 dPositionDy = float3(dLocalDy.x, dot(slope, dLocalDy), dLocalDy.y);

            albedoHeight = 0;
            normalRoughness = 0;
            float3 normalLocal = macroNormal;
            float4 a;
            float4 n;
            if (blend.x > 0.01)
            {
                TerrainSampleProjected(layer, localPosition.zy, dPositionDx.zy, dPositionDy.zy, a, n);
                albedoHeight += a * blend.x;
                normalRoughness.zw += n.zw * blend.x;
                normalLocal += float3(0, n.y, n.x) * blend.x;
            }
            if (blend.z > 0.01)
            {
                TerrainSampleProjected(layer, localPosition.xy, dPositionDx.xy, dPositionDy.xy, a, n);
                albedoHeight += a * blend.z;
                normalRoughness.zw += n.zw * blend.z;
                normalLocal += float3(n.x, n.y, 0) * blend.z;
            }
            if (blend.y > 0.01)
            {
                TerrainSampleProjected(layer, localPosition.xz, dLocalDx, dLocalDy, a, n);
                albedoHeight += a * blend.y;
                normalRoughness.zw += n.zw * blend.y;
                normalLocal += float3(n.x, 0, n.y) * blend.y;
            }
            normalLocal = normalize(normalLocal);

            // Back to the tangent space of the macro normal (as the top-down layers are)
            float3 tangent = normalize(float3(1, 0, 0) - macroNormal * macroNormal.x);
            float3 bitangent = cross(tangent, macroNormal);
            normalRoughness.xy = float2(dot(normalLocal, tangent), dot(normalLocal, bitangent));
        }

        // Covers steep slopes with the cliff layer, projected tri-planar so it doesn't stretch on cliffs.
        // localPosition is the terrain local position (height included), macroNormal the height field normal.
        TerrainSurface TerrainApplyCliff(TerrainSurface surface, float3 localPosition, float3 macroNormal, float2 dLocalDx, float2 dLocalDy)
        {
            if (TerrainCliffParams.x < 0.0)
                return surface;
            float coverage = smoothstep(TerrainCliffParams.y, max(TerrainCliffParams.z, TerrainCliffParams.y + 1e-3), 1.0 - macroNormal.y);
            if (coverage <= 0.0)
                return surface;

            uint layer = (uint)TerrainCliffParams.x;
            float4 tint = TerrainLayerTints[layer];
            float4 albedoHeight;
            float4 normalRoughness;
            TerrainSampleTriplanar(layer, localPosition, macroNormal, TerrainTriplanarBlend(macroNormal), dLocalDx, dLocalDy, albedoHeight, normalRoughness);
            float3 cliffNormalTS = float3(normalRoughness.xy, sqrt(saturate(1.0 - dot(normalRoughness.xy, normalRoughness.xy))));

            surface.Albedo = lerp(surface.Albedo, albedoHeight.rgb * tint.rgb, coverage);
            surface.NormalTS = normalize(lerp(surface.NormalTS, cliffNormalTS, coverage));
            surface.Roughness = lerp(surface.Roughness, saturate(normalRoughness.z * tint.a), coverage);
            surface.Occlusion = lerp(surface.Occlusion, saturate(normalRoughness.w), coverage);
            surface.Height = lerp(surface.Height, saturate(albedoHeight.a), coverage);
            return surface;
        }

        // Transforms a terrain tangent space normal to local space around the macro (height field) normal
        float3 TerrainTangentToLocal(float3 normalTS, float3 macroNormal)
        {
            float3 tangent = normalize(float3(1, 0, 0) - macroNormal * macroNormal.x);
            float3 bitangent = cross(tangent, macroNormal);
            return normalize(normalTS.x * tangent + normalTS.y * bitangent + normalTS.z * macroNormal);
        }
    };
}

namespace Stride.Terrain
{
    /// <summary>
    /// Material pixel stage of the terrain, blending the layers directly (without virtual texturing).
    /// Sets the final world normal itself (the terrain has no tangent frame), so it must run before lighting.
    /// </summary>
    shader TerrainMaterialSurface : IMaterialSurfacePixel, TerrainLayers, TerrainBrushOverlay, NormalStream
    {
        override void Compute()
        {
            float2 localXZ = streams.TerrainLocalXZ;
            float2 dx = ddx(localXZ);
            float2 dy = ddy(localXZ);

            float3 macroNormal = TerrainSampleNormal(localXZ, dx, dy);
            TerrainSurface surface = TerrainSampleLayers(localXZ, dx, dy);
            surface = TerrainApplyCliff(surface, float3(localXZ.x, TerrainSampleHeight(localXZ), localXZ.y), macroNormal, dx, dy);

            streams.normalWS = TerrainTangentToLocal(surface.NormalTS, macroNormal);
            streams.matDiffuse = float4(TerrainApplyBrush(surface.Albedo, localXZ, dx, dy), 1.0);
            streams.matColorBase = streams.matDiffuse;
            streams.matGlossiness = clamp(1.0 - surface.Roughness, 0.0, 0.9);
            streams.matAmbientOcclusion = surface.Occlusion;
        }
    };
}

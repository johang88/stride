<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>$(StrideRuntimeTargetFrameworks)</TargetFrameworks>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--serialization --parameter-key</StrideAssemblyProcessorOptions>
    <StridePackAssets>true</StridePackAssets>
    <StrideCodeAnalysis>true</StrideCodeAnalysis>
    <!-- The terrain, spline and decal components are written in scene assets -->
    <StrideContainsAssetTypes>true</StrideContainsAssetTypes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Companion packages: the terrain and terrain material assets, compilers and templates in .Assets, the terrain tools in .Editor -->
    <StrideCompanionProject Include="..\Stride.Terrain.Assets\Stride.Terrain.Assets.csproj" />
    <StrideCompanionProject Include="..\Stride.Terrain.Editor\Stride.Terrain.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\Stride.Rendering\Stride.Rendering.csproj" />
    <ProjectReference Include="..\..\plugins\BepuPhysics\Stride.BepuPhysics\Stride.BepuPhysics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>
